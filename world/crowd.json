 "fog_model": {
  "rule": "the marine layer is a depth profile, not a binary — it pours over Twin Peaks, dies at the park's west edge, and burns off mid-morning most days; roughly one fog day in four never lifts",
  "stages": [
   "deep",
   "patchy",
   "burned"
  ],
  "day_profile": {
   "overnight": "deep",
   "predawn": "deep",
   "commute": "deep",
   "rush": "patchy",
   "midday": "burned",
   "lunch": "burned",
   "afternoon": "burned",
   "evening": "patchy",
   "night": "deep"
  },
  "burn_hour": 10.5,
  "fog_line": "the park's west edge — extras thin there first; the east sidewalks keep their sun. A spectator reads the line, never the word",
  "all_day": {
   "share": "~1 fog day in 4, heavier May–Aug",
   "profile": "patchy holds midday/lunch/afternoon",
   "effect": "park stays thin; the bench parliament defects to Dolores Perk — same displacement as rain, different reason"
  },
  "reflexes": "no new reflex — fog is not wet, so shelter never fires; gaits unchanged. Fog is a gray read, not an empty one"
 },
 "wind_model": {
  "rule": "afternoon westerlies, strongest 14–18 — felt on stands, stoops, and anyone holding paper",
  "peak_hours": [
   14,
   18
  ],
  "effects": {
   "stand_mult": 0.7,
   "open_air_mult": 0.75,
   "gait": "lean-in",
   "note": "Luz ties the tarps or packs early; Ray's crumb bag stays shut till the gusts pass"
  }
 },
 "season_shades": {
