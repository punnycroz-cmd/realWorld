// Mira painters — removed from the game 2026-09-10 per user request.
// Quarantined here; NOT part of any build.

/* ============ MIRA v3 — fresh redesign ("the braided baker") ============
   New original take, same identity: baker girl, chef hat, brown hair, pink
   top, white apron, baguette. Short puffy scalloped toque with pink gingham
   band, twin braids with ribbon ties, side-swept bangs, Peter-Pan collar,
   puff sleeves, wheat-stitched pocket, scalloped apron hem, side bow,
   buckle-strap boots. Baguette held horizontal in front at chest height in
   idle/walk/talk (signature pose); fresh overhead + side-swing work poses.
   24x32 logical -> black outline -> 48x64, like her 8 neighbors. */
const M_OUTL=N_OUTL;
const M_SKIN='#f5cfa0', M_SKIN_D='#dfa878';
const M_HAIR='#7a4a2c', M_HAIR_D='#5c3620';
const M_TOP='#f2a0a8',  M_TOP_D='#d67f88';
const M_APR='#f4f0e8',  M_APR_D='#d6cec0';
const M_BOT='#8a5a34',  M_BOT_D='#68401f';
const M_PNT='#8a5a34';
const M_BAG='#cf9048',  M_BAG_D='#a96f30', M_BAG_L='#eed9a8';
const M_HAT='#f7f5f1',  M_HAT_D='#d9d5cd';
const M_RIB='#e86a8a',  M_RIB_D='#c4526e', M_BRASS='#d9a441';

/* short puffy toque: scalloped crown, fold lines, pink gingham band */
function miraHat(g,dy,ox){
  paR(g,8+ox,0+dy,8,1,M_HAT);
  paR(g,6+ox,1+dy,12,2,M_HAT);
  paR(g,6+ox,3+dy,13,2,M_HAT);
  paR(g,10+ox,0+dy,1,1,M_HAT_D); paR(g,14+ox,0+dy,1,1,M_HAT_D);
  paLine(g,9+ox,1+dy,12+ox,4+dy,M_HAT_D);
  paLine(g,15+ox,1+dy,13+ox,4+dy,M_HAT_D);
  for(let i=0;i<5;i++) paR(g,7+ox+i*2,5+dy,2,2, i%2? M_HAT : M_RIB);
  paR(g,7+ox,6+dy,10,1,M_RIB_D);
}
/* chunky boot with two buckle straps, 7 wide x 4 tall */
function miraBoot(g,x,y){
  paR(g,x,y,5,3,M_BOT);
  paR(g,x-1,y+2,7,2,M_BOT);
  paR(g,x-1,y+1,7,1,M_BOT_D);
  paR(g,x+2,y+1,2,1,M_BRASS);
  paR(g,x-1,y+3,7,1,M_BOT_D);
  paR(g,x+3,y,2,3,M_BOT_D);
}
/* profile boot with straps, toe pointing left */
function miraBootP(g,x,y){
  paR(g,x+1,y,5,3,M_BOT);
  paR(g,x,y+2,8,2,M_BOT);
  paR(g,x,y+1,8,1,M_BOT_D);
  paR(g,x+3,y+1,2,1,M_BRASS);
  paR(g,x,y+3,8,1,M_BOT_D);
  paR(g,x+4,y,2,3,M_BOT_D);
}
/* one braid segment column, 3 wide, y..y+9, with ribbon bow at the end */
function miraBraid(g,x,y){
  for(let i=0;i<5;i++) paR(g,x,y+i*2,3,2, i%2? M_HAIR_D : M_HAIR);
  paR(g,x-1,y+9,5,2,M_RIB);
  paR(g,x+1,y+9,2,2,M_RIB_D);
}
/* baguette: horizontal loaf, 12x2, 3 pale slashes */
function miraBaguetteH(g,x,y){
  paR(g,x,y,12,2,M_BAG);
  paR(g,x,y+1,12,1,M_BAG_D);
  paR(g,x+2,y,2,1,M_BAG_L); paR(g,x+5,y,2,1,M_BAG_L); paR(g,x+8,y,2,1,M_BAG_L);
  paR(g,x,y,1,2,M_BAG_D); paR(g,x+11,y,1,2,M_BAG_D);
}
/* baguette: thick diagonal loaf for work poses */
function miraBaguetteD(g,x0,y0,x1,y1){
  paLine(g,x0,y0,x1,y1,M_BAG);
  paLine(g,x0,y0-1,x1,y1-1,M_BAG);
  paLine(g,x0,y0+1,x1,y1+1,M_BAG_D);
  const mx=(x0+x1)/2, my=(y0+y1)/2;
  paPX(g,Math.round(mx-2),Math.round(my+1),M_BAG_L);
  paPX(g,Math.round(mx),Math.round(my),M_BAG_L);
  paPX(g,Math.round(mx+2),Math.round(my-1),M_BAG_L);
}
/* front head: hair mass, side-swept bangs, twin braids, shared face, toque */
function miraHeadFront(g,dy,blink,open){
  paEllipse(g,12,12+dy,8,6,M_HAIR);
  paEllipse(g,15,14+dy,5,4,M_HAIR_D);
  paEllipse(g,14,13+dy,5,4,M_HAIR);
  paEllipse(g,12,13+dy,7,5,M_SKIN);
  paEllipse(g,15,14+dy,4,4,M_SKIN_D);
  paEllipse(g,14,13+dy,4,4,M_SKIN);
  paR(g,5,8+dy,11,1,M_HAIR);
  paR(g,6,9+dy,11,1,M_HAIR);
  paR(g,8,10+dy,9,1,M_HAIR);
  paR(g,4,10+dy,2,6,M_HAIR); paR(g,18,10+dy,2,6,M_HAIR);
  nvFaceFront(g,dy,blink,open);
  miraBraid(g,4,12+dy);
  miraBraid(g,17,12+dy);
  miraHat(g,dy,0);
}
/* profile head (facing left): one braid, shared face */
function miraHeadProfile(g,dy,blink,open){
  paEllipse(g,12,12+dy,7,6,M_HAIR);
  paEllipse(g,15,14+dy,5,4,M_HAIR_D);
  paEllipse(g,14,13+dy,5,4,M_HAIR);
  paEllipse(g,9,13+dy,6,5,M_SKIN);
  paEllipse(g,12,14+dy,4,4,M_SKIN_D);
  paEllipse(g,11,13+dy,4,4,M_SKIN);
  paR(g,3,8+dy,8,1,M_HAIR);
  paR(g,4,9+dy,8,1,M_HAIR);
  paR(g,6,10+dy,6,1,M_HAIR);
  nvFaceProfile(g,dy,blink,open);
  miraBraid(g,2,12+dy);
  miraHat(g,dy,-2);
}
/* back head: hair mass + twin braids down the back */
function miraHeadBackFull(g,dy){
  paEllipse(g,12,13+dy,8,6,M_HAIR);
  paEllipse(g,15,15+dy,5,4,M_HAIR_D);
  paEllipse(g,14,14+dy,5,4,M_HAIR);
  paR(g,9,12+dy,1,5,M_HAIR_D); paR(g,14,12+dy,1,5,M_HAIR_D);
  miraBraid(g,7,12+dy);
  miraBraid(g,14,12+dy);
  miraHat(g,dy,0);
}
/* torso front: pink top, Peter-Pan collar, puff sleeves, apron w/ pocket,
   scalloped hem, side bow. Hands hold the baguette in front (signature). */
function miraTorsoFront(g,dy,act,fr){
  paR(g,8,18+dy,8,7,M_TOP);
  paR(g,14,19+dy,2,6,M_TOP_D);
  paR(g,5,18+dy,4,3,M_TOP); paR(g,15,18+dy,4,3,M_TOP);
  paR(g,5,21+dy,4,1,M_TOP_D); paR(g,15,21+dy,4,1,M_TOP_D);
  paR(g,9,19+dy,7,6,M_APR);
  paR(g,13,20+dy,2,5,M_APR_D);
  paR(g,9,18+dy,2,1,M_APR); paR(g,13,18+dy,2,1,M_APR);
  paR(g,9,18+dy,3,2,M_HAT); paR(g,12,18+dy,3,2,M_HAT);
  paR(g,10,21+dy,5,3,M_APR_D);
  paPX(g,11,22+dy,'#e8c35a'); paPX(g,13,22+dy,'#e8c35a'); paPX(g,12,23+dy,'#e8c35a');
  paR(g,9,25+dy,1,1,M_APR); paR(g,11,25+dy,1,1,M_APR);
  paR(g,13,25+dy,1,1,M_APR); paR(g,15,25+dy,1,1,M_APR);
  paR(g,14,22+dy,2,2,M_APR_D); paR(g,18,22+dy,2,2,M_APR_D);
  paR(g,16,22+dy,2,2,M_RIB);
  paR(g,15,24+dy,1,2,M_RIB); paR(g,17,24+dy,1,2,M_RIB);
  if(act==='work'&&fr===0){
    miraBaguetteD(g,7,15+dy,17,7+dy);
    paR(g,6,14+dy,3,5,M_TOP); paR(g,15,7+dy,3,6,M_TOP);
    paR(g,6,14+dy,2,2,M_SKIN); paR(g,16,6+dy,2,2,M_SKIN);
  } else if(act==='work'&&fr===2){
    miraBaguetteD(g,15,19+dy,21,25+dy);
    paR(g,15,18+dy,4,5,M_TOP);
    paR(g,16,22+dy,2,2,M_SKIN);
    paR(g,6,20+dy,3,2,M_TOP); paR(g,7,19+dy,2,2,M_SKIN);
  } else {
    paR(g,6,20+dy,3,2,M_TOP); paR(g,15,20+dy,3,2,M_TOP);
    miraBaguetteH(g,6,19+dy);
    paR(g,7,19+dy,2,2,M_SKIN); paR(g,15,19+dy,2,2,M_SKIN);
  }
}
/* torso profile (facing left) */
function miraTorsoProfile(g,dy,act,fr){
  paR(g,7,18+dy,7,7,M_TOP);
  paR(g,12,19+dy,2,6,M_TOP_D);
  paR(g,4,18+dy,4,3,M_TOP); paR(g,4,21+dy,4,1,M_TOP_D);
  paR(g,8,19+dy,4,6,M_APR);
  paR(g,11,20+dy,1,5,M_APR_D);
  paR(g,8,21+dy,3,2,M_APR_D);
  paPX(g,9,22+dy,'#e8c35a'); paPX(g,10,23+dy,'#e8c35a');
  paR(g,8,25+dy,1,1,M_APR); paR(g,10,25+dy,1,1,M_APR);
  paR(g,7,18+dy,3,2,M_HAT);
  if(act==='work'&&fr===0){
    miraBaguetteD(g,2,16+dy,11,8+dy);
    paR(g,3,14+dy,3,5,M_TOP);
    paR(g,2,13+dy,2,2,M_SKIN); paR(g,10,7+dy,2,2,M_SKIN);
  } else if(act==='work'&&fr===2){
    miraBaguetteD(g,9,19+dy,15,25+dy);
    paR(g,8,18+dy,4,5,M_TOP);
    paR(g,9,22+dy,2,2,M_SKIN);
  } else {
    paR(g,3,20+dy,4,2,M_TOP);
    miraBaguetteH(g,0,19+dy);
    paR(g,3,19+dy,2,2,M_SKIN); paR(g,7,19+dy,2,2,M_SKIN);
  }
}
/* torso back: criss-cross straps, apron back, side bow peeking */
function miraTorsoBack(g,dy,act,fr){
  paR(g,8,18+dy,8,7,M_TOP);
  paR(g,14,19+dy,2,6,M_TOP_D);
  paR(g,5,18+dy,4,3,M_TOP); paR(g,15,18+dy,4,3,M_TOP);
  paR(g,5,21+dy,4,1,M_TOP_D); paR(g,15,21+dy,4,1,M_TOP_D);
  paLine(g,8,18+dy,16,22+dy,M_APR);
  paLine(g,16,18+dy,8,22+dy,M_APR);
  paR(g,9,22+dy,6,3,M_APR);
  paR(g,9,25+dy,1,1,M_APR); paR(g,11,25+dy,1,1,M_APR); paR(g,13,25+dy,1,1,M_APR);
  paR(g,17,22+dy,2,2,M_RIB); paR(g,16,24+dy,1,2,M_RIB);
  const swinging=act==='walk'&&fr===0;
  const swinging2=act==='walk'&&fr===2;
  if(!(act==='work'&&(fr===0||fr===2))){
    paR(g,6,19+dy+(swinging?-1:0),2,5,M_TOP); paR(g,16,19+dy+(swinging2?-1:0),2,5,M_TOP);
    paR(g,6,24+dy+(swinging?-1:0),2,2,M_SKIN); paR(g,16,24+dy+(swinging2?-1:0),2,2,M_SKIN);
  }
  if(act==='work'&&fr===0){
    miraBaguetteD(g,14,14+dy,20,8+dy);
    paR(g,14,14+dy,3,6,M_TOP);
    paR(g,14,12+dy,2,2,M_SKIN);
  } else if(act==='work'&&fr===2){
    miraBaguetteD(g,15,18+dy,21,24+dy);
    paR(g,15,18+dy,3,5,M_TOP);
    paR(g,15,22+dy,2,2,M_SKIN);
  }
}
/* legs + strap boots, standing poses */
function miraLegsBoots(g,dir,act,fr,dy){
  let l1=25,l2=25;
  if(act==='walk'){ if(fr===0) l1=24; else if(fr===2) l2=24; }
  if(dir===2){
    paR(g,8,l1+dy,2,3,M_PNT); paR(g,11,l2+dy,2,3,M_PNT);
    miraBootP(g,5,l1+3+dy); miraBootP(g,9,l2+3+dy);
  } else {
    paR(g,9,l1+dy,2,3,M_PNT); paR(g,13,l2+dy,2,3,M_PNT);
    miraBoot(g,7,l1+3+dy); miraBoot(g,12,l2+3+dy);
  }
}
function miraFront(g,act,fr){
  const dy=(act==='walk'&&(fr===1||fr===3))?1:0;
  const blink=act==='idle'&&fr===1;
  const open=act==='talk'&&fr===1;
  miraLegsBoots(g,0,act,fr,dy);
  miraTorsoFront(g,dy,act,fr);
  miraHeadFront(g,dy,blink,open);
}
function miraProfile(g,act,fr){
  const dy=(act==='walk'&&(fr===1||fr===3))?1:0;
  const blink=act==='idle'&&fr===1;
  const open=act==='talk'&&fr===1;
  miraLegsBoots(g,2,act,fr,dy);
  miraTorsoProfile(g,dy,act,fr);
  miraHeadProfile(g,dy,blink,open);
}
function miraBack(g,act,fr){
  const dy=(act==='walk'&&(fr===1||fr===3))?1:0;
  miraLegsBoots(g,1,act,fr,dy);
  miraTorsoBack(g,dy,act,fr);
  miraHeadBackFull(g,dy);
}
/* seated: baguette resting across the lap */
function miraSitLogical(g,fr){
  const blink=fr===1;
  paR(g,5,27,14,3,M_PNT);
  paEllipse(g,12,28,7,2,M_PNT);
  miraBoot(g,3,27); miraBoot(g,16,27);
  paR(g,8,20,8,7,M_TOP);
  paR(g,14,21,2,6,M_TOP_D);
  paR(g,5,20,4,3,M_TOP); paR(g,15,20,4,3,M_TOP);
  paR(g,5,23,4,1,M_TOP_D); paR(g,15,23,4,1,M_TOP_D);
  paR(g,9,21,6,6,M_APR);
  paR(g,13,22,2,5,M_APR_D);
  paR(g,10,23,4,2,M_APR_D);
  paR(g,9,20,7,2,M_HAT);
  paR(g,6,21,3,3,M_TOP); paR(g,15,21,3,3,M_TOP);
  miraBaguetteH(g,6,25);
  paR(g,7,24,2,2,M_SKIN); paR(g,15,24,2,2,M_SKIN);
  miraHeadFront(g,2,blink,false);
}
/* dispatcher: logical paint -> black outline -> 48x64 */
function miraFrame(spec,dir,act,fr){
  const L=paMk(24,32), g=L.g;
  if(act==='sit') miraSitLogical(g,fr);
  else if(dir===1) miraBack(g,act,fr);
  else if(dir===2) miraProfile(g,act,fr);
  else miraFront(g,act,fr);
  paOutline(L.c,M_OUTL);
  const s=paMk(48,64), g2=s.g;
  g2.imageSmoothingEnabled=false;
  g2.drawImage(L.c,0,0,48,64);
  return s.c;
}


/* Mira helpers for the shared composer (head-only + palette) */
function miraHeadBack(g,dy){
  miraHeadBackFull(g,dy);
}
function miraHeadOnly(g,dir,dy,blink,open){
  if(dir===2) miraHeadProfile(g,dy,blink,open);
  else if(dir===1) miraHeadBack(g,dy);
  else miraHeadFront(g,dy,blink,open);
}
const MIRA_PAL={
  skin:'#f5cfa0', skinD:'#dfa878',
  hair:'#7a4a2c', hairD:'#5c3620',
  shirt:'#f2a0a8', shirtD:'#d67f88',
  pants:'#8a5a34', pantsD:'#68401f',
  boots:'#8a5a34', bootsD:'#68401f',
  apron:'#f4f0e8', apronD:'#d6cec0',
  sleepHat:function(g){
    paR(g,4,10,6,1,M_HAT); paR(g,3,11,8,2,M_HAT);
    paR(g,7,10,1,1,M_HAT_D);
    paR(g,3,13,2,1,M_RIB); paR(g,5,13,2,1,M_HAT);
    paR(g,7,13,2,1,M_RIB); paR(g,9,13,2,1,M_HAT);
  }
};
