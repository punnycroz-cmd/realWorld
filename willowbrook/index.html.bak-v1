<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Willowbrook — A Cozy Village Game</title>
<style>
  :root{
    --ui-bg: rgba(20,26,38,.86);
    --ui-bg2: rgba(30,40,58,.92);
    --accent:#ffd98a;
    --text:#f4efe4;
    --muted:#b9c2d0;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{width:100%;height:100%;overflow:hidden;background:#0b0f16;
    font-family:"Trebuchet MS","Segoe UI",Verdana,sans-serif;color:var(--text);
    -webkit-user-select:none;user-select:none}
  #app{position:fixed;inset:0;display:flex;flex-direction:column}
  /* ---------- top bar ---------- */
  #topbar{height:52px;flex:0 0 auto;display:flex;align-items:center;gap:10px;
    padding:0 12px;background:linear-gradient(180deg,#1b2434,#141b29);
    border-bottom:1px solid #2c3a52;z-index:20}
  #logo{font-weight:800;font-size:17px;letter-spacing:.5px;color:var(--accent);white-space:nowrap}
  #logo small{font-weight:400;color:var(--muted);font-size:11px;letter-spacing:1px}
  #clock-chip,#day-chip{background:var(--ui-bg2);border:1px solid #3a4c68;border-radius:10px;
    padding:6px 12px;font-size:14px;white-space:nowrap;display:flex;align-items:center;gap:7px}
  #clock-chip b{color:var(--accent);font-size:15px;min-width:52px;text-align:center}
  #char-chip{background:var(--ui-bg2);border:1px solid #3a4c68;border-radius:10px;
    padding:5px 12px;font-size:13px;display:flex;align-items:center;gap:9px;min-width:0}
  #char-chip .dot{width:12px;height:12px;border-radius:50%;border:2px solid rgba(255,255,255,.55);flex:0 0 auto}
  #char-chip .nm{font-weight:700;white-space:nowrap}
  #char-chip .rl{color:var(--muted);font-size:12px;white-space:nowrap}
  #gold-chip{background:var(--ui-bg2);border:1px solid #3a4c68;border-radius:10px;
    padding:6px 12px;font-size:13px;white-space:nowrap}
  #gold-chip b{color:var(--accent)}
  .spacer{flex:1}
  .tbtn{background:var(--ui-bg2);border:1px solid #3a4c68;color:var(--text);border-radius:10px;
    padding:7px 11px;font-size:14px;cursor:pointer;transition:background .15s}
  .tbtn:hover{background:#3b4f70}
  /* ---------- game area ---------- */
  #stage{position:relative;flex:1 1 auto;overflow:hidden;background:#000}
  #game{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:crosshair}
  #minimap{position:absolute;top:10px;right:10px;width:172px;height:129px;
    border:2px solid rgba(255,255,255,.25);border-radius:8px;background:#0e1420;z-index:10;opacity:.95}
  /* prompt + dialogue */
  #prompt{position:absolute;left:50%;bottom:118px;transform:translateX(-50%);
    background:var(--ui-bg);border:1px solid #4a5f82;border-radius:10px;
    padding:8px 16px;font-size:14px;display:none;z-index:11;white-space:nowrap}
  #prompt b{color:var(--accent)}
  #dialogue{position:absolute;left:50%;bottom:64px;transform:translateX(-50%);
    width:min(560px,92%);background:var(--ui-bg);border:1px solid #4a5f82;border-radius:14px;
    padding:12px 16px 10px;display:none;z-index:12;box-shadow:0 8px 30px rgba(0,0,0,.5)}
  #dialogue .who{font-weight:800;color:var(--accent);font-size:14px;margin-bottom:4px}
  #dialogue .who span{color:var(--muted);font-weight:400;font-size:12px;margin-left:6px}
  #dialogue .line{font-size:15px;line-height:1.45;min-height:44px}
  #dialogue .hint{font-size:11px;color:var(--muted);text-align:right;margin-top:4px}
  #floater-layer{position:absolute;inset:0;pointer-events:none;z-index:9;overflow:hidden}
  .floater{position:absolute;font-size:14px;font-weight:700;color:#ffe9a8;
    text-shadow:0 2px 4px #000;white-space:nowrap;animation:floatUp 1.8s ease-out forwards}
  @keyframes floatUp{0%{opacity:0;transform:translateY(8px)}15%{opacity:1}100%{opacity:0;transform:translateY(-46px)}}
  /* ---------- bottom bar ---------- */
  #bottombar{flex:0 0 auto;display:flex;align-items:center;gap:14px;padding:7px 14px;
    background:linear-gradient(0deg,#1b2434,#141b29);border-top:1px solid #2c3a52;
    font-size:12.5px;color:var(--muted);z-index:20;flex-wrap:wrap}
  #bottombar kbd{background:#0e1420;border:1px solid #3a4c68;border-bottom-width:3px;border-radius:6px;
    padding:1px 7px;font-family:inherit;color:var(--text);font-size:12px}
  /* ---------- overlays ---------- */
  .overlay{position:absolute;inset:0;z-index:30;display:flex;align-items:center;justify-content:center;
    background:radial-gradient(ellipse at center,rgba(10,16,28,.72),rgba(4,7,12,.92));backdrop-filter:blur(3px)}
  .card{background:linear-gradient(180deg,#22304a,#182236);border:1px solid #465c7e;border-radius:18px;
    padding:34px 44px;text-align:center;max-width:520px;box-shadow:0 20px 60px rgba(0,0,0,.6)}
  .card h1{font-size:38px;color:var(--accent);letter-spacing:1px;margin-bottom:6px}
  .card h2{font-size:14px;color:var(--muted);font-weight:400;margin-bottom:18px;letter-spacing:2px}
  .card p{font-size:14px;line-height:1.6;color:#d7dee9;margin-bottom:8px}
  .card .controls{margin:16px 0;font-size:13px;color:var(--muted);line-height:2}
  .card .controls kbd{background:#0e1420;border:1px solid #3a4c68;border-bottom-width:3px;border-radius:6px;
    padding:2px 9px;color:var(--text)}
  .bigbtn{background:linear-gradient(180deg,#ffcf7d,#e8a94e);border:none;border-radius:12px;
    padding:13px 54px;font-size:19px;font-weight:800;color:#4a2f0e;cursor:pointer;margin-top:14px;
    box-shadow:0 6px 20px rgba(232,169,78,.35);transition:transform .12s}
  .bigbtn:hover{transform:scale(1.05)}
  #loading .card h1{font-size:26px}
  .spin{width:44px;height:44px;border:4px solid #3a4c68;border-top-color:var(--accent);border-radius:50%;
    margin:18px auto;animation:sp 1s linear infinite}
  @keyframes sp{to{transform:rotate(360deg)}}
  #errbox{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);z-index:60;
    background:#5c1a1a;border:1px solid #a03a3a;color:#ffd9d9;border-radius:10px;
    padding:8px 16px;font-size:13px;display:none;max-width:90%}
  #help .card{text-align:left;max-width:560px}
  #help h1{font-size:24px;text-align:center}
  #help li{font-size:14px;line-height:1.9;list-style:none;color:#d7dee9}
  #help li b{color:var(--accent)}
  #autotest{position:absolute;top:60px;left:10px;z-index:50;background:rgba(0,0,0,.8);
    border:1px solid #4a5f82;border-radius:8px;padding:10px 14px;font-size:12px;
    max-width:420px;max-height:70%;overflow:auto;display:none;white-space:pre-wrap}
</style>
</head>
<body>
<div id="app">
  <div id="topbar">
    <div id="logo">🌾 WILLOWBROOK <small>COZY VILLAGE</small></div>
    <div id="day-chip">📅 Day <b id="ui-day" style="color:var(--accent)">1</b></div>
    <div id="clock-chip">🕐 <b id="ui-clock">08:00</b> <span id="ui-phase" style="color:var(--muted)">Morning</span></div>
    <div id="char-chip"><span class="dot" id="ui-dot"></span><span class="nm" id="ui-name">—</span><span class="rl" id="ui-role">—</span></div>
    <div id="gold-chip">🪙 <b id="ui-gold">20</b> &nbsp;🎒 <span id="ui-inv">empty</span></div>
    <div class="spacer"></div>
    <button class="tbtn" id="btn-sound" title="Toggle sound">🔊</button>
    <button class="tbtn" id="btn-speed" title="Toggle game speed">▶ 1×</button>
    <button class="tbtn" id="btn-full" title="Fullscreen">⛶</button>
    <button class="tbtn" id="btn-help" title="Help">?</button>
  </div>
  <div id="stage">
    <canvas id="game"></canvas>
    <canvas id="minimap" width="172" height="129"></canvas>
    <div id="floater-layer"></div>
    <div id="prompt"></div>
    <div id="dialogue"><div class="who"><span id="dlg-name"></span><span id="dlg-role"></span></div>
      <div class="line" id="dlg-line"></div><div class="hint">E / click — continue · Esc — close</div></div>
    <div id="loading" class="overlay"><div class="card"><h1>🌾 WILLOWBROOK</h1>
      <div class="spin"></div><p id="load-msg">Waking up the village…</p></div></div>
    <div id="start" class="overlay" style="display:none"><div class="card">
      <h1>🌾 WILLOWBROOK</h1><h2>A COZY VILLAGE TALE</h2>
      <p>Click any villager to step into their shoes. Explore the village, chat with neighbors,
      harvest crops, fish at the pond — and watch the village live its day while you wander.</p>
      <div class="controls">
        <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or <kbd>←</kbd><kbd>↑</kbd><kbd>↓</kbd><kbd>→</kbd> move &nbsp;·&nbsp;
        <kbd>Click</kbd> select villager / walk there<br>
        <kbd>E</kbd> interact &nbsp;·&nbsp; <kbd>Tab</kbd> switch villager &nbsp;·&nbsp; <kbd>Esc</kbd> close
      </div>
      <button class="bigbtn" id="btn-play">▶ &nbsp;Enter the village</button>
    </div></div>
    <div id="help" class="overlay" style="display:none"><div class="card">
      <h1>How to play</h1><ul>
      <li><b>Click a villager</b> — select &amp; control them (ring + name appear).</li>
      <li><b>WASD / arrows</b> — walk. <b>Click ground</b> — walk there.</li>
      <li><b>E</b> or <b>click</b> glowing objects — talk, harvest, fish, sit, shop…</li>
      <li><b>Tab</b> — hop to the next villager. Uncontrolled villagers live their own day.</li>
      <li>Earn 🪙: harvest crops, sell at the store, fish at the dock. Buy bread 🍞.</li>
      <li>Villagers work by day, head home at night. Lamps light up after dark.</li>
      </ul>
      <div style="text-align:center"><button class="bigbtn" id="btn-help-close" style="padding:10px 40px;font-size:15px">Close</button></div>
    </div></div>
    <div id="errbox"></div>
    <div id="autotest"></div>
  </div>
  <div id="bottombar">
    <span><kbd>Click</kbd> villager = control</span>
    <span><kbd>WASD</kbd> move</span>
    <span><kbd>E</kbd> interact</span>
    <span><kbd>Tab</kbd> next villager</span>
    <span id="hint-context" style="color:var(--accent)"></span>
  </div>
</div>
<script>
'use strict';
/* =====================================================================
   WILLOWBROOK — a cozy village game in a single file.
   Vanilla JS + Canvas 2D. All art is drawn procedurally at runtime,
   so the game has zero external assets and cannot fail to load them.
   ===================================================================== */

/* ------------------------------ config ------------------------------ */
const TILE = 32, MW = 64, MH = 48;
const WORLD_W = MW * TILE, WORLD_H = MH * TILE;
// tiles
const T_GRASS=0, T_PATH=1, T_WATER=2, T_BRIDGE=3, T_TILLED=4, T_SAND=5, T_FLOOR=6;
// game clock: one full 24h day = 600 real seconds at 1x
const DAY_SECONDS = 600, MIN_PER_SEC = 1440 / DAY_SECONDS;
const NPC_SPEED = 58, PLAYER_SPEED = 105;

/* ------------------------------ utils ------------------------------- */
const clamp=(v,a,b)=>v<a?a:(v>b?b:v);
const lerp=(a,b,t)=>a+(b-a)*t;
function dist(ax,ay,bx,by){const dx=ax-bx,dy=ay-by;return Math.sqrt(dx*dx+dy*dy);}
function rand(a,b){return a+Math.random()*(b-a);}
function randi(a,b){return Math.floor(rand(a,b+1));}
function choice(arr){return arr[Math.floor(Math.random()*arr.length)];}
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function pad2(n){return (n<10?'0':'')+n;}
function tileAt(tx,ty){ if(tx<0||ty<0||tx>=MW||ty>=MH) return T_WATER; return tiles[ty*MW+tx]; }
function px(tx){return tx*TILE;} function py(ty){return ty*TILE;}
// simple seeded rng so the village layout is stable between loads
let _seed = 1234567;
function srand(){ _seed = (_seed*1664525 + 1013904223) >>> 0; return _seed/4294967296; }
function srange(a,b){ return a + srand()*(b-a); }
function srangei(a,b){ return Math.floor(srange(a,b+1)); }
function schance(p){ return srand() < p; }

/* ------------------------------ game state -------------------------- */
const G = {
  running:false, started:false, timeMin: 8*60, day:1, speed:1,
  villagers:[], controlled:0, cam:{x:WORLD_W/2,y:WORLD_H/2},
  keys:{}, gold:20, inv:{crop:0,bread:0,fish:0,herb:0},
  floaters:[], particles:[], dialogue:null, dlgIdx:0,
  moveTarget:null, hoverV:null, promptFor:null,
  errCount:0, muted:false, frame:0,
  walkPhase:0,
};
const tiles = new Uint8Array(MW*MH);          // tile ids
const solid = new Uint8Array(MW*MH);          // 1 = blocked for movement
const buildings = [];   // {id,name,tx,ty,tw,th,kind,door:{tx,ty},palette}
const objects = [];     // {kind,x,y,w,h,opts} pixel coords, y = base
const interactables = []; // {x,y,r,label,hint,action,cond}
const crops = [];       // crop objects are also in objects; this holds growth state
let groundCanvas = null;  // prerendered terrain
let miniGround = null;

/* =====================================================================
   WORLD GENERATION
   ===================================================================== */
function buildWorld(){
  tiles.fill(T_GRASS);

  const path=(x0,y0,x1,y1)=>{ // L-shaped path
    const sx=x0<x1?1:-1;
    for(let x=x0;x!==x1+sx;x+=sx) setPath(x,y0);
    const sy=y0<y1?1:-1;
    for(let y=y0;y!==y1+sy;y+=sy) setPath(x1,y);
  };
  const setPath=(x,y)=>{ if(x>=0&&y>=0&&x<MW&&y<MH && tiles[y*MW+x]!==T_WATER) tiles[y*MW+x]=T_PATH; };

  // main roads
  for(let x=5;x<=59;x++) setPath(x,24);          // horizontal
  for(let y=7;y<=46;y++) setPath(32,y);          // vertical
  // plaza
  for(let dy=-5;dy<=5;dy++)for(let dx=-5;dx<=5;dx++){
    if(dx*dx+dy*dy<=26) setPath(32+dx,24+dy);
  }
  // pond (east)
  const pcx=49,pcy=30,prx=5.5,pry=4.2;
  for(let y=0;y<MH;y++)for(let x=0;x<MW;x++){
    const dx=(x-pcx)/prx, dy=(y-pcy)/pry, d=dx*dx+dy*dy;
    if(d<1) tiles[y*MW+x]=T_WATER;
    else if(d<1.35) tiles[y*MW+x]=T_SAND;
  }
  // beach approach to the dock (kept walkable)
  for(let x=42;x<=45;x++) tiles[30*MW+x]=T_SAND;
  // stream from pond to south edge
  for(let y=34;y<MH;y++){ tiles[y*MW+47]=T_WATER; tiles[y*MW+48]=T_WATER; }
  // bridge over stream (planks over water)
  for(let x=45;x<=50;x++){ tiles[39*MW+x]=T_BRIDGE; }
  setPath(44,39); setPath(51,39);
  // path to pond dock
  for(let x=37;x<=46;x++) setPath(x,30);
  // dock: bridge tiles into the pond
  tiles[30*MW+46]=T_BRIDGE; tiles[30*MW+47]=T_BRIDGE; tiles[30*MW+48]=T_BRIDGE;
  // farm tilled soil
  for(let y=28;y<=33;y++)for(let x=8;x<=15;x++) tiles[y*MW+x]=T_TILLED;
  // herb garden
  for(let y=9;y<=11;y++)for(let x=46;x<=49;x++) tiles[y*MW+x]=T_TILLED;
  // branch paths to buildings (drawn after buildings placed)
  buildBuildings();
  const spur=(dx,dy)=>{ path(32,24,dx,dy); };
  for(const b of buildings){ if(b.door) spur(b.door.tx,b.door.ty); }
  // south entrance
  for(let y=44;y<=47;y++) setPath(31,y), setPath(32,y), setPath(33,y);

  buildObjects();
  buildCollision();
  buildInteractables();
  prerenderGround();
}

function addBuilding(id,name,tx,ty,tw,th,kind,pal){
  const b={id,name,tx,ty,tw,th,kind,door:{tx:tx+Math.floor(tw/2),ty:ty+th},pal};
  buildings.push(b); return b;
}
function buildBuildings(){
  const wood={wall:'#c9a06b',wallD:'#a67c4e',roof:'#a34d3a',roofD:'#7e382a',trim:'#f2e4c2'};
  const stone={wall:'#b8b2a4',wallD:'#8f887a',roof:'#5d6b7d',roofD:'#455061',trim:'#f2e4c2'};
  const plaster={wall:'#e8dcc0',wallD:'#c4b493',roof:'#9c5a44',roofD:'#77422f',trim:'#fff6e0'};
  addBuilding('townhall','Town Hall',29,12,6,5,'hall',stone);
  addBuilding('inn','The Sleepy Stag Inn',26,32,6,5,'inn',wood);
  addBuilding('store',"Marlow's General Store",38,18,5,4,'store',plaster);
  addBuilding('smithy','Forge & Anvil',18,14,5,4,'smithy',{wall:'#9a8a78',wallD:'#776857',roof:'#4c4c55',roofD:'#36363c',trim:'#f2e4c2'});
  addBuilding('farmhouse','Farmhouse',9,20,4,4,'house',wood);
  addBuilding('house1','Cottage',22,9,4,4,'house',plaster);
  addBuilding('house2','Cottage',38,9,4,4,'house',wood);
  addBuilding('house3','Cottage',15,36,4,4,'house',plaster);
  addBuilding('house4','Cottage',43,33,4,4,'house',wood);
  addBuilding('house5','Cottage',27,40,4,4,'house',plaster);
  addBuilding('herbhut','Herbalist Hut',42,4,4,4,'hut',{wall:'#a8bf8e',wallD:'#829a68',roof:'#6d7f5c',roofD:'#525f45',trim:'#f2e4c2'});
}

function addObj(kind,tx,ty,opts){
  const o=Object.assign({kind,x:px(tx)+TILE/2,y:py(ty)+TILE,w:TILE,h:TILE},opts||{});
  objects.push(o); return o;
}
function buildObjects(){
  // --- well on the plaza ---
  addObj('well',31,23,{w:40,h:40});
  // --- lamps along roads ---
  for(let x=10;x<=58;x+=8) addObj('lamp',x,22.4);
  for(let x=14;x<=54;x+=10) addObj('lamp',x,25.6);
  for(let y=10;y<=42;y+=8){ addObj('lamp',30.4,y); }
  addObj('lamp',45,28.4); addObj('lamp',28,38.4);
  // --- benches ---
  addObj('bench',29,22,{face:1}); addObj('bench',35,26,{face:3});
  addObj('bench',44,28,{face:1}); addObj('bench',28,34.5,{face:0});
  // --- signposts ---
  addObj('sign',30,42,{text:'Willowbrook'}); addObj('sign',29,25.6,{text:'Plaza'});
  // --- barrels & crates ---
  const spots=[[24,15],[25.6,15],[40,22.6],[41.4,22.6],[31,37.6],[32.4,37.6],[16,17],[43,7]];
  for(const [sx,sy] of spots){ addObj(schance(.5)?'barrel':'crate',sx,sy); }
  // --- fences around farm ---
  for(let x=7;x<=16;x++){ addObj('fence',x,27,{h:18}); if(x!==11&&x!==12) addObj('fence',x,34,{h:18}); }
  for(let y=28;y<=33;y++){ addObj('fence',7,y,{h:18}); addObj('fence',16,y,{h:18}); }
  // --- crops on the farm ---
  for(let y=28;y<=33;y++)for(let x=8;x<=15;x++){
    if(schance(.85)) addObj('crop',x,y,{growth:srange(0,1),cropKind:'crop'});
  }
  // --- herb garden crops ---
  for(let y=9;y<=11;y++)for(let x=46;x<=49;x++) addObj('crop',x,y,{growth:srange(.2,1),cropKind:'herb'});
  // --- trees: forest border + clusters ---
  const treeOk=(tx,ty)=>{
    if(tx<1||ty<1||tx>=MW-1||ty>=MH-1) return false;
    const t=tileAt(tx,ty);
    if(t===T_WATER||t===T_BRIDGE||t===T_PATH||t===T_TILLED) return false;
    for(const b of buildings){ if(tx>=b.tx-1&&tx<b.tx+b.tw+1&&ty>=b.ty-1&&ty<b.ty+b.th+1) return false; }
    return true;
  };
  for(let x=0;x<MW;x++)for(let y=0;y<MH;y++){
    const edge = x<3||y<3||x>=MW-3||y>=MH-3;
    const entrance = (y>=44&&x>=30&&x<=34);
    if(edge && !entrance && schance(.8) && treeOk(x,y)) addObj(schance(.6)?'tree':'pine',x,y,{s:srange(.8,1.25)});
    else if(!edge && schance(.028) && treeOk(x,y)) addObj(schance(.55)?'tree':'pine',x,y,{s:srange(.8,1.2)});
  }
  // --- bushes, flowers, rocks (decor) ---
  for(let i=0;i<130;i++){
    const tx=srangei(2,MW-3), ty=srangei(2,MH-3);
    if(!treeOk(tx,ty)) continue;
    const r=srand();
    if(r<.45) addObj('flower',tx+srange(0,1),ty+srange(0,1),{c:choice(['#e86a8a','#f2d06b','#ffffff','#b678e0'])});
    else if(r<.75) addObj('bush',tx,ty,{s:srange(.7,1.1)});
    else addObj('rock',tx,ty,{s:srange(.6,1)});
  }
  // --- market stall near store ---
  addObj('stall',44,20,{});
  // --- forge extras ---
  addObj('anvil',23.5,15.5,{}); addObj('grindstone',17,16.5,{});
  // --- dock posts ---
  addObj('dockpost',48.5,29,{}); addObj('dockpost',48.5,31,{});
}

function solidRectPx(x,y,w,h){
  const x0=Math.floor(x/TILE), x1=Math.floor((x+w)/TILE), y0=Math.floor(y/TILE), y1=Math.floor((y+h)/TILE);
  for(let ty=y0;ty<=y1;ty++)for(let tx=x0;tx<=x1;tx++){
    if(tx>=0&&ty>=0&&tx<MW&&ty<MH) solid[ty*MW+tx]=1;
  }
}
function buildCollision(){
  solid.fill(0);
  for(let y=0;y<MH;y++)for(let x=0;x<MW;x++){
    const t=tiles[y*MW+x];
    if(t===T_WATER) solid[y*MW+x]=1; // bridges drawn over water stay walkable
  }
  for(const b of buildings){
    solidRectPx(px(b.tx),py(b.ty),b.tw*TILE,b.th*TILE-6); // leave door row step-out
  }
  for(const o of objects){
    if(o.kind==='tree'||o.kind==='pine') solidRectPx(o.x-9,o.y-9,18,18);
    else if(o.kind==='well') solidRectPx(o.x-16,o.y-16,32,32);
    else if(o.kind==='fence') solidRectPx(o.x-14,o.y-8,28,10);
    else if(o.kind==='lamp') solidRectPx(o.x-4,o.y-4,8,8);
    else if(o.kind==='barrel'||o.kind==='crate') solidRectPx(o.x-11,o.y-11,22,22);
    else if(o.kind==='rock') solidRectPx(o.x-8,o.y-8,16,16);
    else if(o.kind==='stall') solidRectPx(o.x-24,o.y-14,48,28);
    else if(o.kind==='anvil'||o.kind==='grindstone') solidRectPx(o.x-10,o.y-10,20,20);
    else if(o.kind==='sign') solidRectPx(o.x-4,o.y-4,8,8);
  }
  // door tiles must be walkable
  for(const b of buildings){ solid[b.door.ty*MW+b.door.tx]=0; }
}
function walkable(tx,ty){
  if(tx<0||ty<0||tx>=MW||ty>=MH) return false;
  return !solid[ty*MW+tx];
}

/* =====================================================================
   RENDERING — procedural sprites
   ===================================================================== */
function makeCanvas(w,h){ const c=document.createElement('canvas'); c.width=w; c.height=h; return c; }

function prerenderGround(){
  groundCanvas = makeCanvas(WORLD_W, WORLD_H);
  const g = groundCanvas.getContext('2d');
  // base grass with subtle noise
  g.fillStyle='#7fae5a'; g.fillRect(0,0,WORLD_W,WORLD_H);
  for(let i=0;i<9000;i++){
    const x=srange(0,WORLD_W), y=srange(0,WORLD_H);
    g.fillStyle = schance(.5)?'rgba(0,0,0,0.05)':'rgba(255,255,255,0.05)';
    g.fillRect(x,y,2,2);
  }
  for(let y=0;y<MH;y++)for(let x=0;x<MW;x++){
    const t=tiles[y*MW+x], X=x*TILE, Y=y*TILE;
    if(t===T_PATH) drawPathTile(g,X,Y,x,y);
    else if(t===T_WATER) drawWaterTile(g,X,Y,x,y);
    else if(t===T_BRIDGE) drawBridgeTile(g,X,Y,x,y);
    else if(t===T_TILLED) drawTilledTile(g,X,Y,x,y);
    else if(t===T_SAND){ g.fillStyle='#dcc98f'; g.fillRect(X,Y,TILE,TILE); }
    else if(t===T_FLOOR){ g.fillStyle='#b09a72'; g.fillRect(X,Y,TILE,TILE); }
  }
  // mini map ground
  miniGround = makeCanvas(MW,MH);
  const mg = miniGround.getContext('2d');
  const cols=['#5d8a42','#c2a06b','#3f6fb5','#8a6a45','#6b4f30','#dcc98f','#b09a72'];
  for(let y=0;y<MH;y++)for(let x=0;x<MW;x++){
    mg.fillStyle=cols[tiles[y*MW+x]]||'#5d8a42'; mg.fillRect(x,y,1,1);
  }
}
function drawPathTile(g,X,Y,tx,ty){
  g.fillStyle='#c9a26b'; g.fillRect(X,Y,TILE,TILE);
  g.fillStyle='rgba(0,0,0,0.06)';
  // edge blend: darken where neighbor is grass
  if(tileAt(tx,ty-1)!==T_PATH&&tileAt(tx,ty-1)!==T_BRIDGE){ g.fillRect(X,Y,TILE,4); }
  if(tileAt(tx,ty+1)!==T_PATH&&tileAt(tx,ty+1)!==T_BRIDGE){ g.fillRect(X,Y+TILE-4,TILE,4); }
  if(tileAt(tx-1,ty)!==T_PATH&&tileAt(tx-1,ty)!==T_BRIDGE){ g.fillRect(X,Y,4,TILE); }
  if(tileAt(tx+1,ty)!==T_PATH&&tileAt(tx+1,ty)!==T_BRIDGE){ g.fillRect(X+TILE-4,Y,4,TILE); }
  // pebbles (deterministic per tile)
  let h=(tx*73856093)^(ty*19349663); h=(h^(h>>13))*1274126177;
  const rr=()=>{ h=(h^(h>>13))*1274126177; h>>>=0; return h/4294967295; };
  for(let i=0;i<4;i++){
    g.fillStyle=rr()<.5?'rgba(0,0,0,0.10)':'rgba(255,255,255,0.10)';
    g.fillRect(X+4+rr()*24, Y+4+rr()*24, 3, 2);
  }
}
function drawWaterTile(g,X,Y,tx,ty){
  const t=G.frame*0.03 + (tx+ty)*0.7;
  g.fillStyle='#3f7fc4'; g.fillRect(X,Y,TILE,TILE);
  g.fillStyle='rgba(255,255,255,0.10)';
  g.fillRect(X, Y+8+Math.sin(t)*3, TILE, 2);
  g.fillRect(X, Y+22+Math.cos(t*0.8)*3, TILE, 2);
  g.fillStyle='rgba(0,0,0,0.12)';
  if(tileAt(tx,ty-1)!==T_WATER) g.fillRect(X,Y,TILE,3);
}
function drawBridgeTile(g,X,Y,tx,ty){
  g.fillStyle='#3f7fc4'; g.fillRect(X,Y,TILE,TILE); // water under
  g.fillStyle='#8a6a45'; g.fillRect(X,Y+2,TILE,TILE-4);
  g.fillStyle='#6e5335';
  for(let i=0;i<4;i++) g.fillRect(X,Y+2+i*8,TILE,2);
  g.fillStyle='#5c452b'; g.fillRect(X,Y,TILE,3); g.fillRect(X,Y+TILE-3,TILE,3);
}
function drawTilledTile(g,X,Y){
  g.fillStyle='#6b4f30'; g.fillRect(X,Y,TILE,TILE);
  g.fillStyle='#5a4128';
  for(let i=0;i<4;i++) g.fillRect(X+2,Y+4+i*8,TILE-4,3);
  g.fillStyle='rgba(255,255,255,0.05)'; g.fillRect(X+2,Y+2,TILE-4,2);
}

/* ------------------------------ buildings --------------------------- */
function drawBuilding(g,b,night){
  const X=px(b.tx), Y=py(b.ty), W=b.tw*TILE, H=b.th*TILE;
  const p=b.pal;
  // shadow
  g.fillStyle='rgba(0,0,0,0.22)';
  g.beginPath(); g.ellipse(X+W/2,Y+H-4,W/2+6,8,0,0,7); g.fill();
  // walls
  g.fillStyle=p.wall; g.fillRect(X+4,Y+H*0.34,W-8,H*0.66-4);
  g.fillStyle=p.wallD; g.fillRect(X+4,Y+H-12,W-8,8);
  // timber frame lines
  g.strokeStyle='rgba(0,0,0,0.18)'; g.lineWidth=2;
  for(let i=1;i<4;i++){ g.beginPath(); g.moveTo(X+4+i*(W-8)/4, Y+H*0.34); g.lineTo(X+4+i*(W-8)/4, Y+H-4); g.stroke(); }
  // roof (front-facing gable)
  const rh=H*0.44;
  g.fillStyle=p.roofD;
  g.beginPath(); g.moveTo(X-6,Y+H*0.38); g.lineTo(X+W/2,Y+H*0.38-rh); g.lineTo(X+W+6,Y+H*0.38); g.closePath(); g.fill();
  g.fillStyle=p.roof;
  g.beginPath(); g.moveTo(X-6,Y+H*0.38); g.lineTo(X+W/2,Y+H*0.38-rh); g.lineTo(X+W/2,Y+H*0.38); g.closePath(); g.fill();
  // roof shingle lines
  g.strokeStyle='rgba(0,0,0,0.15)'; g.lineWidth=1;
  for(let i=1;i<4;i++){ const yy=Y+H*0.38-i*rh/4;
    g.beginPath(); g.moveTo(X-6+ i*3, yy); g.lineTo(X+W+6 - i*3, yy); g.stroke(); }
  // door
  const dw=22, dh=30, dxn=X+W/2-dw/2, dyn=Y+H-4-dh;
  g.fillStyle='#4a3524'; g.fillRect(dxn-2,dyn-2,dw+4,dh+2);
  g.fillStyle=night?'#ffca7a':'#5c452b'; g.fillRect(dxn,dyn,dw,dh);
  g.fillStyle='#2e2117'; g.fillRect(dxn+dw-6,dyn+dh/2,3,3);
  // windows (glow at night)
  const wins = b.tw>=5 ? [-W*0.28, W*0.28] : [-W*0.3, W*0.3];
  for(const off of wins){
    const wx=X+W/2+off-9, wy=Y+H*0.52;
    g.fillStyle=p.trim; g.fillRect(wx-2,wy-2,22,20);
    g.fillStyle=night?'#ffd98a':'#2c3a4a'; g.fillRect(wx,wy,18,16);
    g.strokeStyle=p.trim; g.lineWidth=2;
    g.beginPath(); g.moveTo(wx+9,wy); g.lineTo(wx+9,wy+16); g.moveTo(wx,wy+8); g.lineTo(wx+18,wy+8); g.stroke();
  }
  // kind extras
  if(b.kind==='smithy'){ // chimney with smoke
    g.fillStyle='#5a5a62'; g.fillRect(X+W-26,Y-6,16,H*0.4);
    g.fillStyle='rgba(120,120,130,0.5)';
    const t=G.frame*0.02;
    for(let i=0;i<3;i++){ const sy=Y-14-((G.frame*0.5+i*22)%66);
      g.beginPath(); g.arc(X+W-18+Math.sin(t+i)*6, sy, 5+i*2, 0, 7); g.fill(); }
    // forge glow at night
    if(night){ g.fillStyle='rgba(255,140,40,0.85)'; g.fillRect(dxn,dyn,dw,dh); }
  }
  if(b.kind==='inn'){ // hanging sign
    g.strokeStyle='#3a2c1e'; g.lineWidth=3;
    g.beginPath(); g.moveTo(X+W-14,Y+H*0.42); g.lineTo(X+W-14,Y+H*0.42+16); g.stroke();
    g.fillStyle='#7a5c38'; g.fillRect(X+W-30,Y+H*0.42+14,32,22);
    g.fillStyle='#3a2c1e'; g.font='bold 11px sans-serif'; g.textAlign='center';
    g.fillText('🦌', X+W-14, Y+H*0.42+31);
  }
  if(b.kind==='store'){ // awning
    g.fillStyle='#b8452e';
    for(let i=0;i<5;i++){ g.fillStyle=i%2?'#b8452e':'#f2e4c2'; g.fillRect(X+6+i*(W-12)/5, Y+H*0.34, (W-12)/5, 10); }
  }
  b._glowSpots = b._glowSpots || wins.map(off=>({x:X+W/2+off, y:Y+H*0.52+8}));
}

/* ------------------------------ objects ----------------------------- */
function drawObject(g,o){
  const night = darkness()>0.45;
  switch(o.kind){
    case 'tree': case 'pine': {
      const s=o.s||1;
      g.fillStyle='rgba(0,0,0,0.20)';
      g.beginPath(); g.ellipse(o.x,o.y,s*16,s*5,0,0,7); g.fill();
      g.fillStyle='#6b4f30'; g.fillRect(o.x-3*s,o.y-26*s,6*s,26*s);
      if(o.kind==='tree'){
        g.fillStyle='#4e8a3c';
        g.beginPath(); g.arc(o.x,o.y-40*s,20*s,0,7); g.fill();
        g.fillStyle='#5da244';
        g.beginPath(); g.arc(o.x-7*s,o.y-46*s,13*s,0,7); g.fill();
        g.fillStyle='rgba(255,255,255,0.08)';
        g.beginPath(); g.arc(o.x-7*s,o.y-46*s,8*s,0,7); g.fill();
      } else {
        g.fillStyle='#3d7a34';
        for(let i=0;i<3;i++){ const w=(26-i*7)*s, yy=o.y-24*s-i*16*s;
          g.beginPath(); g.moveTo(o.x-w/2,yy); g.lineTo(o.x+w/2,yy); g.lineTo(o.x,yy-20*s); g.closePath(); g.fill(); }
      }
      break; }
    case 'bush': {
      const s=o.s||1;
      g.fillStyle='#4e8a3c'; g.beginPath(); g.arc(o.x,o.y-8*s,12*s,0,7); g.fill();
      g.fillStyle='#5da244'; g.beginPath(); g.arc(o.x-4*s,o.y-11*s,7*s,0,7); g.fill();
      break; }
    case 'flower': {
      g.strokeStyle='#3f7a30'; g.lineWidth=2;
      g.beginPath(); g.moveTo(o.x,o.y); g.lineTo(o.x,o.y-10); g.stroke();
      g.fillStyle=o.c; g.beginPath(); g.arc(o.x,o.y-12,4,0,7); g.fill();
      g.fillStyle='#fff'; g.beginPath(); g.arc(o.x,o.y-12,1.6,0,7); g.fill();
      break; }
    case 'rock': {
      const s=o.s||1;
      g.fillStyle='#8d8d94'; g.beginPath(); g.ellipse(o.x,o.y-6*s,12*s,8*s,0,0,7); g.fill();
      g.fillStyle='#a5a5ac'; g.beginPath(); g.ellipse(o.x-3*s,o.y-9*s,6*s,4*s,0,0,7); g.fill();
      break; }
    case 'fence': {
      g.fillStyle='#8a6a45'; g.fillRect(o.x-16,o.y-14,32,5); g.fillRect(o.x-16,o.y-7,32,5);
      g.fillStyle='#75572f'; g.fillRect(o.x-3,o.y-18,6,20);
      break; }
    case 'lamp': {
      g.fillStyle='#3a3f4a'; g.fillRect(o.x-2,o.y-34,4,34);
      g.fillStyle='#2c3038'; g.fillRect(o.x-8,o.y-42,16,10);
      const on = night;
      g.fillStyle=on?'#ffe9a8':'#9aa4b5'; g.fillRect(o.x-5,o.y-40,10,6);
      if(on){ o._glow={x:o.x,y:o.y-37,r:70}; }
      break; }
    case 'well': {
      g.fillStyle='rgba(0,0,0,0.22)'; g.beginPath(); g.ellipse(o.x,o.y+8,22,7,0,0,7); g.fill();
      g.fillStyle='#8d8d94'; g.fillRect(o.x-18,o.y-22,36,30);
      g.fillStyle='#a5a5ac'; g.fillRect(o.x-18,o.y-22,36,8);
      g.fillStyle='#1c2733'; g.beginPath(); g.ellipse(o.x,o.y-22,14,5,0,0,7); g.fill();
      g.fillStyle='#6b4f30'; g.fillRect(o.x-20,o.y-52,6,32); g.fillRect(o.x+14,o.y-52,6,32);
      g.fillStyle='#a34d3a';
      g.beginPath(); g.moveTo(o.x-24,o.y-48); g.lineTo(o.x,o.y-64); g.lineTo(o.x+24,o.y-48); g.closePath(); g.fill();
      break; }
    case 'bench': {
      g.fillStyle='#7a5c38'; g.fillRect(o.x-20,o.y-12,40,7);
      g.fillStyle='#5c452b'; g.fillRect(o.x-18,o.y-5,5,8); g.fillRect(o.x+13,o.y-5,5,8);
      break; }
    case 'barrel': {
      g.fillStyle='#8a6a45'; g.beginPath(); g.ellipse(o.x,o.y-20,13,5,0,0,7); g.fill();
      g.fillRect(o.x-13,o.y-20,26,20);
      g.fillStyle='#6e5335'; g.fillRect(o.x-13,o.y-12,26,3); g.fillRect(o.x-13,o.y-4,26,3);
      break; }
    case 'crate': {
      g.fillStyle='#a37f4e'; g.fillRect(o.x-12,o.y-22,24,22);
      g.strokeStyle='#75572f'; g.lineWidth=3;
      g.strokeRect(o.x-12,o.y-22,24,22);
      g.beginPath(); g.moveTo(o.x-12,o.y-22); g.lineTo(o.x+12,o.y); g.moveTo(o.x+12,o.y-22); g.lineTo(o.x-12,o.y); g.stroke();
      break; }
    case 'sign': {
      g.fillStyle='#6b4f30'; g.fillRect(o.x-2,o.y-30,4,30);
      g.fillStyle='#8a6a45'; g.fillRect(o.x-18,o.y-44,36,16);
      g.fillStyle='#3a2c1e'; g.font='bold 9px sans-serif'; g.textAlign='center';
      g.fillText(o.text||'', o.x, o.y-32);
      break; }
    case 'stall': {
      g.fillStyle='rgba(0,0,0,0.18)'; g.beginPath(); g.ellipse(o.x,o.y+4,34,8,0,0,7); g.fill();
      g.fillStyle='#8a6a45'; g.fillRect(o.x-28,o.y-16,56,18);
      g.fillStyle='#c9a26b'; g.fillRect(o.x-28,o.y-18,56,5);
      g.fillStyle='#6b4f30'; g.fillRect(o.x-30,o.y-44,4,44); g.fillRect(o.x+26,o.y-44,4,44);
      g.fillStyle='#b8452e';
      for(let i=0;i<6;i++){ g.fillStyle=i%2?'#b8452e':'#f2e4c2'; g.fillRect(o.x-32+i*11,o.y-56,11,12); }
      // goods
      g.fillStyle='#d94f3d'; g.beginPath(); g.arc(o.x-12,o.y-22,5,0,7); g.fill();
      g.fillStyle='#e8a94e'; g.beginPath(); g.arc(o.x+2,o.y-22,5,0,7); g.fill();
      g.fillStyle='#7fae5a'; g.beginPath(); g.arc(o.x+16,o.y-22,5,0,7); g.fill();
      break; }
    case 'anvil': {
      g.fillStyle='#3a3f4a'; g.fillRect(o.x-12,o.y-18,24,8);
      g.fillRect(o.x-4,o.y-10,8,10);
      g.fillStyle='#565c68'; g.fillRect(o.x-12,o.y-18,24,3);
      break; }
    case 'grindstone': {
      g.fillStyle='#6b4f30'; g.fillRect(o.x-10,o.y-16,20,16);
      g.fillStyle='#8d8d94'; g.beginPath(); g.arc(o.x,o.y-20,10,0,7); g.fill();
      g.fillStyle='#5c5c63'; g.beginPath(); g.arc(o.x,o.y-20,3,0,7); g.fill();
      break; }
    case 'dockpost': {
      g.fillStyle='#5c452b'; g.fillRect(o.x-3,o.y-24,6,24);
      break; }
    case 'crop': {
      const gr=o.growth;
      if(gr<0.25){ g.strokeStyle='#4e8a3c'; g.lineWidth=2;
        g.beginPath(); g.moveTo(o.x,o.y); g.lineTo(o.x,o.y-6); g.stroke(); }
      else if(gr<0.85){
        g.strokeStyle='#3f7a30'; g.lineWidth=3;
        g.beginPath(); g.moveTo(o.x,o.y); g.lineTo(o.x,o.y-14); g.stroke();
        g.fillStyle='#4e8a3c';
        g.beginPath(); g.ellipse(o.x-5,o.y-9,5,3,-0.5,0,7); g.fill();
        g.beginPath(); g.ellipse(o.x+5,o.y-11,5,3,0.5,0,7); g.fill();
      } else {
        if(o.cropKind==='herb'){
          g.fillStyle='#7fae5a'; g.beginPath(); g.arc(o.x,o.y-10,9,0,7); g.fill();
          g.fillStyle='#b678e0';
          for(let i=0;i<5;i++){ g.beginPath(); g.arc(o.x-6+i*3,o.y-14+((i%2)*4),2.4,0,7); g.fill(); }
        } else {
          g.strokeStyle='#3f7a30'; g.lineWidth=3;
          g.beginPath(); g.moveTo(o.x,o.y); g.lineTo(o.x,o.y-16); g.stroke();
          g.fillStyle='#e8a94e';
          g.beginPath(); g.arc(o.x-4,o.y-18,4.5,0,7); g.fill();
          g.beginPath(); g.arc(o.x+4,o.y-16,4.5,0,7); g.fill();
          g.fillStyle='#d94f3d'; g.beginPath(); g.arc(o.x,o.y-21,3.4,0,7); g.fill();
        }
      }
      break; }
  }
}

/* ------------------------------ characters -------------------------- */
function drawVillager(g,v){
  const x=v.x, y=v.y;
  const L=v.look;
  const ph=v.walkPhase;
  const moving = v.state==='walk'&&v.moving;
  const bob = moving ? Math.sin(ph*10)*1.6 : Math.sin(G.frame*0.04+v.seed)*0.8;
  // shadow + selection ring
  g.fillStyle='rgba(0,0,0,0.25)';
  g.beginPath(); g.ellipse(x,y+2,11,4.5,0,0,7); g.fill();
  if(v===controlledVillager()){
    g.strokeStyle='#ffd98a'; g.lineWidth=2.5;
    g.beginPath(); g.ellipse(x,y+2,15,7,0,0,7); g.stroke();
    const pl=1+Math.sin(G.frame*0.08)*0.12;
    g.strokeStyle='rgba(255,217,138,0.5)';
    g.beginPath(); g.ellipse(x,y+2,18*pl,9*pl,0,0,7); g.stroke();
  }
  const f=v.face; // 0 down,1 up,2 left,3 right
  const yo = bob;
  const legSwing = moving ? Math.sin(ph*10)*4 : 0;
  if(v.state==='sleep'){
    // lying down
    g.fillStyle=L.skin; g.beginPath(); g.arc(x+8,y-6,7,0,7); g.fill();
    g.fillStyle=L.shirt; roundRect(g,x-14,y-12,28,12,5); g.fill();
    g.fillStyle='#3a4a6b'; roundRect(g,x-16,y-2,34,7,3); g.fill(); // blanket
    g.fillStyle='#2c3a4a'; g.fillRect(x-16,y-2,34,2);
    g.fillStyle='#2b2b2b'; g.fillRect(x+6,y-8,4,1.5); // closed eye
    if(Math.floor(G.frame/40)%2===0){ g.fillStyle='rgba(255,255,255,0.7)'; g.font='bold 12px sans-serif'; g.fillText('z',x+20,y-22); }
    return;
  }
  if(v.state==='sit'){
    const sx=v.sitAt?v.sitAt.x:x, sy=v.sitAt?v.sitAt.y:y;
    g.fillStyle=L.pants; roundRect(g,sx-9,sy-16,18,12,4); g.fill();
    g.fillStyle=L.shirt; roundRect(g,sx-8,sy-30,16,16,5); g.fill();
    g.fillStyle=L.skin; g.beginPath(); g.arc(sx,sy-36,7,0,7); g.fill();
    drawHair(g,sx,sy-36,L,f,true);
    g.fillStyle='#2b2b2b'; g.fillRect(sx-4,sy-38,2.5,2.5); g.fillRect(sx+2,sy-38,2.5,2.5);
    return;
  }
  // legs
  const legY = y-14;
  g.fillStyle=L.pants;
  if(moving){
    roundRect(g,x-7+legSwing*0.4,legY,6,14,3); g.fill();
    roundRect(g,x+1-legSwing*0.4,legY,6,14,3); g.fill();
  } else { roundRect(g,x-7,legY,6,14,3); g.fill(); roundRect(g,x+1,legY,6,14,3); g.fill(); }
  // arms (behind/in front depending on state)
  const armSwing = moving ? Math.sin(ph*10+Math.PI)*3 : 0;
  g.fillStyle=L.shirt;
  const workUp = v.state==='work';
  if(workUp){
    const wv=Math.sin(G.frame*0.25)*5;
    roundRect(g,x-13,yo+y-34+wv*0.3,5,12,2); g.fill();
    roundRect(g,x+8,yo+y-34-wv*0.3,5,12,2); g.fill();
  } else if(f===1){ // facing up: arms hidden-ish
    roundRect(g,x-11,yo+y-32,5,12,2); g.fill();
    roundRect(g,x+6,yo+y-32,5,12,2); g.fill();
  } else {
    roundRect(g,x-11,yo+y-32+armSwing*0.3,5,12,2); g.fill();
    roundRect(g,x+6,yo+y-32-armSwing*0.3,5,12,2); g.fill();
  }
  // torso
  g.fillStyle=L.shirt; roundRect(g,x-9,yo+y-34,18,20,6); g.fill();
  if(L.apron){ g.fillStyle=L.apron; roundRect(g,x-6,yo+y-28,12,14,3); g.fill(); }
  g.fillStyle='rgba(0,0,0,0.12)'; g.fillRect(x-9,yo+y-18,18,4);
  // head
  const hy=yo+y-42;
  g.fillStyle=L.skin; g.beginPath(); g.arc(x,hy,8,0,7); g.fill();
  drawHair(g,x,hy,L,f,false);
  // face
  g.fillStyle='#2b2b2b';
  if(f===0){ g.fillRect(x-4.5,hy-1,3,3.4); g.fillRect(x+1.5,hy-1,3,3.4);
    if(v.state==='talk'){ g.fillStyle='#7a3b2e'; g.beginPath(); g.ellipse(x,hy+4.5,2.4,1.6+Math.sin(G.frame*0.3)*1,0,0,7); g.fill(); }
  } else if(f===2){ g.fillRect(x-6,hy-1,3,3.4); }
  else if(f===3){ g.fillRect(x+3,hy-1,3,3.4); }
  // beard
  if(L.beard){ g.fillStyle=L.hair; g.beginPath(); g.arc(x,hy+5,5.5,0.3,Math.PI-0.3); g.fill(); }
  // work tool
  if(workUp && L.tool){
    g.strokeStyle='#6b4f30'; g.lineWidth=3;
    g.beginPath(); g.moveTo(x+10,yo+y-30); g.lineTo(x+16,yo+y-44); g.stroke();
    if(L.tool==='hammer'){ g.fillStyle='#8d8d94'; g.fillRect(x+12,yo+y-50,9,6); }
    if(L.tool==='hoe'){ g.fillStyle='#8d8d94'; g.fillRect(x+12,yo+y-48,8,4); }
  }
  // talk bubble
  if(v.state==='talk'){
    g.fillStyle='#fff'; g.beginPath(); g.ellipse(x+16,hy-16,9,7,0,0,7); g.fill();
    g.beginPath(); g.moveTo(x+9,hy-11); g.lineTo(x+5,hy-5); g.lineTo(x+12,hy-9); g.fill();
    g.fillStyle='#2b2b2b'; g.font='bold 10px sans-serif'; g.textAlign='center';
    g.fillText('…',x+16,hy-12);
  }
}
function drawHair(g,x,hy,L,f,sitting){
  const c=L.hair;
  g.fillStyle=c;
  const st=L.hairStyle;
  if(st==='short'){
    g.beginPath(); g.arc(x,hy-3,8.4,Math.PI,0); g.fill();
    g.fillRect(x-8.4,hy-4,16.8,3);
    if(f===1){ g.fillRect(x-8.4,hy-6,16.8,7); }
  } else if(st==='long'){
    g.beginPath(); g.arc(x,hy-3,8.6,Math.PI,0); g.fill();
    g.fillRect(x-8.6,hy-4,5,16); g.fillRect(x+3.6,hy-4,5,16);
    if(f===1){ g.fillRect(x-8.6,hy-6,17.2,18); }
    else { g.fillRect(x-8.6,hy-5,17.2,4); }
  } else if(st==='bun'){
    g.beginPath(); g.arc(x,hy-3,8.2,Math.PI,0); g.fill();
    g.beginPath(); g.arc(x,hy-13,4.5,0,7); g.fill();
  } else if(st==='bald'){
    g.beginPath(); g.arc(x,hy-4,8,Math.PI,0); g.fill();
    g.fillRect(x-8,hy-5,16,2);
  } else if(st==='cap'){
    g.fillStyle=L.hat||'#b8452e';
    g.beginPath(); g.arc(x,hy-4,8.6,Math.PI,0); g.fill();
    g.fillRect(x-10,hy-6,20,3);
  } else if(st==='hood'){
    g.fillStyle=L.hat||'#5d6b7d';
    g.beginPath(); g.arc(x,hy-3,10,Math.PI*0.95,Math.PI*0.05); g.fill();
    g.fillRect(x-10,hy-6,20,8);
  } else if(st==='braid'){
    g.beginPath(); g.arc(x,hy-3,8.4,Math.PI,0); g.fill();
    g.fillRect(x+4,hy-4,5,18);
    g.fillStyle='rgba(0,0,0,0.15)'; g.fillRect(x+4,hy+2,5,2); g.fillRect(x+4,hy+8,5,2);
  }
}
function roundRect(g,x,y,w,h,r){
  g.beginPath();
  g.moveTo(x+r,y); g.arcTo(x+w,y,x+w,y+h,r); g.arcTo(x+w,y+h,x,y+h,r);
  g.arcTo(x,y+h,x,y,r); g.arcTo(x,y,x+w,y,r); g.closePath();
}
/* ------------------------------ interactables ----------------------- */
function addInter(x,y,r,label,hint,action,cond){
  interactables.push({x,y,r,label,hint,action,cond});
}
function buildInteractables(){
  for(const b of buildings){
    const dx=px(b.door.tx)+TILE/2, dy=py(b.door.ty)+TILE/2;
    addInter(dx,dy,34,b.name,'knock / enter',()=>{
      const v=controlledVillager();
      if(b.id==='store'){ openShop(); return; }
      if(b.id==='inn'&&v){ floater(v.x,v.y-40,'“Warm beds, hot stew!”'); }
      say(b.name, bLine(b.id));
    });
  }
  const well=objects.find(o=>o.kind==='well');
  if(well) addInter(well.x,well.y,40,'Old Well','drink',()=>{
    const v=controlledVillager();
    floater(v.x,v.y-40,'💧 “Cool and sweet!”');
    sfx('drink');
  });
  for(const o of objects){
    if(o.kind==='bench') addInter(o.x,o.y,30,'Bench','sit',()=>{
      const v=controlledVillager(); v.state='sit'; v.sitAt={x:o.x,y:o.y+6};
      v.path=null; floater(v.x,v.y-40,'…');
    });
    if(o.kind==='sign') addInter(o.x,o.y,30,'Signpost','read',()=>{ say('Signpost', '“'+o.text+' — pop. 48”'); });
    if(o.kind==='barrel'||o.kind==='crate') addInter(o.x,o.y,30,o.kind==='barrel'?'Barrel':'Crate','search',()=>{
      const v=controlledVillager();
      if(Math.random()<.4){ G.gold+=2; floater(v.x,v.y-40,'+2 🪙'); }
      else floater(v.x,v.y-40,choice(['Dusty…','Empty.','Old tools.','Smells of apples.']));
      sfx('pop');
    });
    if(o.kind==='anvil') addInter(o.x,o.y,34,'Anvil','work',()=>{
      const v=controlledVillager(); v.state='work'; v.workT=3; floater(v.x,v.y-40,'🔨 Clang!');
    });
  }
  for(const o of objects){
    if(o.kind==='crop') addInter(o.x,o.y,26,o.growth>0.85?(o.cropKind==='herb'?'Herbs':'Crops'):'Sprouts','harvest / inspect',()=>harvestCrop(o));
  }
  // fishing spot at dock end
  addInter(px(48)+TILE/2, py(30)+TILE/2, 44,'Fishing Spot','fish',()=>startFishing());
  // pond swim? no — just look
  addInter(px(45)+TILE/2, py(31)+TILE/2, 40,'Pond','look',()=>{
    say('Pond','Dragonflies skim the still water. A frog plops somewhere out of sight.');
  });
}
function bLine(id){
  return {
    townhall:'Mayor Alden holds court here on market days. The door is carved with wheat and oak leaves.',
    inn:'Lamplight spills from the windows. Someone is laughing inside — probably Tobin telling a story.',
    store:'Shelves of jars, bolts of cloth, and the smell of fresh bread. Sella keeps fair prices.',
    smithy:'Heat shimmers above the forge. The ring of the hammer never quite stops.',
    farmhouse:'Marta’s farmhouse. Chickens? Not yet — but the fields look promising.',
    house1:'A tidy cottage with blue shutters.', house2:'A tidy cottage with green shutters.',
    house3:'A small cottage. Fishing nets dry on the fence.', house4:'The mayor’s house, a little grander than the rest.',
    house5:'Pip’s family cottage. A wooden sword leans by the door.',
    herbhut:'The air smells of lavender and sage. Wren’s hut hums with quiet industry.',
  }[id]||'A cozy village building.';
}
/* =====================================================================
   VILLAGERS + AI
   ===================================================================== */
function controlledVillager(){ return G.villagers[G.controlled]; }

function makeVillagers(){
  const V=(name,role,look,homeId,workTx,workTy,lines,workLine)=>({
    name, role, look, homeId, workTx, workTy, lines, workLine,
    x:0,y:0, face:0, state:'idle', moving:false, walkPhase:Math.random()*6,
    seed:Math.random()*100, path:null, pathI:0, aiT:Math.random()*2,
    dirMode:'home', wanderT:0, sitAt:null, workT:0, talking:0, dlg:null,
    isNPC:true, stuckT:0, lastX:0, lastY:0,
  });
  const defs=[
    V('Marta','Farmer',{skin:'#f2c89b',hair:'#6b4a2e',hairStyle:'long',shirt:'#7fae5a',pants:'#5c452b',apron:'#c9a26b',tool:'hoe'},
      'farmhouse',11.5,30.5,
      ['Morning! The soil is kind today.','Carrots by autumn, mark my words.','You look hungry — take an apple, on the house.'],
      'These rows won’t weed themselves.'),
    V('Bram','Blacksmith',{skin:'#d9a06b',hair:'#2b2b2b',hairStyle:'short',shirt:'#4c4c55',pants:'#2e2e33',apron:'#3a3f4a',beard:true,tool:'hammer'},
      'house1',20.5,19.2,
      ['Need a horseshoe? A plowshare? I’m your man.','Mind the sparks, friend.','Good steel takes patience. So do I.'],
      'Clang… clang… nearly done.'),
    V('Sella','Shopkeeper',{skin:'#f2c89b',hair:'#b8452e',hairStyle:'bun',shirt:'#9c5a44',pants:'#5c452b',apron:'#f2e4c2'},
      'house2',40.5,23,
      ['Welcome, welcome! Bread’s fresh today.','Fair prices, honest scales — that’s my motto.','Looking to sell crops? I pay 3 gold each.'],
      'Let me just tidy these shelves…'),
    V('Tobin','Innkeeper',{skin:'#e8b88a',hair:'#7a5c38',hairStyle:'bald',shirt:'#7a5c38',pants:'#3a2c1e',beard:true},
      'inn',28.5,30.6,
      ['Pull up a stool! Stew’s on the fire.','Travelers bring the best stories. And the worst singing.','Rooms are clean, ale is cold. What more do you need?'],
      'Polishing mugs… always polishing mugs.'),
    V('Wren','Herbalist',{skin:'#f2c89b',hair:'#4a6b2e',hairStyle:'braid',shirt:'#6d7f5c',pants:'#4a5a3e',hat:'#5d6b7d'},
      'herbhut',47.5,10.5,
      ['Sage for courage, lavender for sleep.','The garden tells me what it needs. I listen.','That cough? Thyme tea. Trust me.'],
      'Snip, bundle, hang to dry…'),
    V('Finn','Fisherman',{skin:'#d9a06b',hair:'#2b2b2b',hairStyle:'cap',hat:'#3f6fb5',shirt:'#3f6fb5',pants:'#2c3a4a'},
      'house3',47.6,30,
      ['The big one got away. Again.','Pond’s calm today — good fishing.','You ever tried pond-skipping stones? Art, I tell you.'],
      'Shhh… feel that nibble?'),
    V('Alden','Mayor',{skin:'#f2c89b',hair:'#cfcfcf',hairStyle:'short',shirt:'#6b3a4a',pants:'#2e2117',beard:true},
      'house4',32,18.2,
      ['Willowbrook prospers because we look after each other.','A festival, you say? I’ll bring it to the council!','Walk with me — a mayor should know every path.'],
      'Petitions… budgets… where did I put that seal?'),
    V('Pip','Kid',{skin:'#f2c89b',hair:'#e8a94e',hairStyle:'short',shirt:'#e86a8a',pants:'#3f6fb5'},
      'house5',32,24,
      ['Have you SEEN the frog by the pond? He’s huge!','When I grow up I’m gonna be a dragon rider.','Race you to the well! …You’re slow.'],
      'La la la… nothing to do, everything to do!'),
  ];
  for(const v of defs){
    const b=buildings.find(b=>b.id===v.homeId);
    v.x=px(b.door.tx)+TILE/2; v.y=py(b.door.ty)+TILE/2+10;
    v.homeTx=b.door.tx; v.homeTy=b.door.ty;
    v.path=null; v.aiT=Math.random()*1.5;
    G.villagers.push(v);
  }
}

/* ------------------------------ A* pathfinding ---------------------- */
function findPath(sx,sy,tx,ty){
  // pixel coords in/out (waypoints), tile coords for endpoints
  let stx=Math.floor(sx/TILE), sty=Math.floor(sy/TILE);
  let etx=Math.floor(tx/TILE), ety=Math.floor(ty/TILE);
  if(!walkable(etx,ety)){
    // nudge to nearest walkable neighbor
    let best=null,bd=1e9;
    for(let dy=-2;dy<=2;dy++)for(let dx=-2;dx<=2;dx++){
      if(walkable(etx+dx,ety+dy)){ const d=dx*dx+dy*dy; if(d<bd){bd=d;best=[etx+dx,ety+dy];} }
    }
    if(!best) return null;
    etx=best[0]; ety=best[1];
  }
  if(stx===etx&&sty===ety) return [{x:tx,y:ty}];
  const W=MW,H=MH, key=(x,y)=>y*W+x;
  const open=[{x:stx,y:sty,g:0,f:0,p:null}];
  const gScore=new Map([[key(stx,sty),0]]);
  const closed=new Set();
  const huer=(x,y)=>Math.abs(x-etx)+Math.abs(y-ety);
  let found=null, guard=0;
  while(open.length&&guard++<6000){
    let bi=0;
    for(let i=1;i<open.length;i++) if(open[i].f<open[bi].f) bi=i;
    const cur=open.splice(bi,1)[0];
    const ck=key(cur.x,cur.y);
    if(closed.has(ck)) continue;
    closed.add(ck);
    if(cur.x===etx&&cur.y===ety){ found=cur; break; }
    const dirs=[[1,0],[-1,0],[0,1],[0,-1]];
    // slight random order for organic variation
    if(Math.random()<0.5){ const t=dirs[0]; dirs[0]=dirs[2]; dirs[2]=t; }
    for(const [dx,dy] of dirs){
      const nx=cur.x+dx, ny=cur.y+dy;
      if(!walkable(nx,ny)||closed.has(key(nx,ny))) continue;
      const ng=cur.g+1;
      const nk=key(nx,ny);
      if(ng < (gScore.get(nk)??Infinity)){
        gScore.set(nk,ng);
        open.push({x:nx,y:ny,g:ng,f:ng+huer(nx,ny),p:cur});
      }
    }
  }
  if(!found) return null;
  const cells=[];
  for(let n=found;n;n=n.p) cells.push(n);
  cells.reverse();
  // simplify: keep every cell (cheap) — convert to pixel waypoints, skip start cell
  const pts=cells.slice(1).map(c=>({x:c.x*TILE+TILE/2, y:c.y*TILE+TILE/2}));
  pts.push({x:tx,y:ty});
  return pts;
}

/* ------------------------------ NPC brains -------------------------- */
function directiveFor(v,tMin){
  // returns {mode, tx, ty}
  const H=n=>n*60;
  if(v.name==='Pip'){
    if(tMin<H(20.5)&&tMin>=H(7)) return {mode:'wander',tx:32,ty:24,r:9};
    if(tMin>=H(20.5)||tMin<H(7)) return {mode:'sleep'};
    return {mode:'home'};
  }
  if(tMin>=H(21)||tMin<H(5.5)) return {mode:'sleep'};
  if(tMin>=H(5.5)&&tMin<H(8)) return {mode:'gowork'};
  if(tMin>=H(8)&&tMin<H(12)) return {mode:'work'};
  if(tMin>=H(12)&&tMin<H(13.5)) return {mode:'wander',tx:32,ty:24,r:7};
  if(tMin>=H(13.5)&&tMin<H(17.5)) return {mode:'work'};
  if(tMin>=H(17.5)&&tMin<H(19.5)) return {mode:'wander',tx:45,ty:30,r:8};
  if(tMin>=H(19.5)&&tMin<H(21)) return {mode:'home'};
  return {mode:'home'};
}
function npcThink(v){
  if(v.state==='talk'&&v.talking>0) return; // don't interrupt a conversation
  const d=directiveFor(v,G.timeMin);
  v.dirMode=d.mode;
  if(d.mode==='sleep'){
    const hx=px(v.homeTx)+TILE/2, hy=py(v.homeTy)+TILE/2+14;
    if(dist(v.x,v.y,hx,hy)>20){ setPathTo(v,hx,hy); }
    else { v.path=null; v.moving=false; v.state='sleep'; }
  } else if(d.mode==='home'){
    const hx=px(v.homeTx)+TILE/2, hy=py(v.homeTy)+TILE/2+14;
    if(dist(v.x,v.y,hx,hy)>24){ setPathTo(v,hx,hy); }
    else { v.path=null; v.moving=false; if(v.state!=='talk') v.state='idle'; }
  } else if(d.mode==='gowork'||d.mode==='work'){
    const wx=px(v.workTx)+TILE/2, wy=py(v.workTy)+TILE/2;
    if(dist(v.x,v.y,wx,wy)>26){ setPathTo(v,wx,wy); }
    else { v.path=null; v.moving=false; if(v.state!=='talk'){ v.state='work'; v.workT+=1; } }
  } else if(d.mode==='wander'){
    v.wanderT-=1;
    const arrived=!v.path||v.pathI>=v.path.length;
    if(arrived&&v.wanderT<=0){
      const a=rand(0,Math.PI*2), r=rand(1,(d.r||6))*TILE;
      const tx=px(d.tx)+Math.cos(a)*r, ty=py(d.ty)+Math.sin(a)*r*0.7;
      setPathTo(v,clamp(tx,TILE,WORLD_W-TILE),clamp(ty,TILE,WORLD_H-TILE));
      v.wanderT=rand(4,11);
      if(v.state!=='talk') v.state='idle';
    }
  }
}
function setPathTo(v,tx,ty){
  // avoid repathing to (nearly) the same target every think tick
  if(v._ptx!==undefined && dist(v._ptx,v._pty,tx,ty)<24 && v.path && v.pathI<v.path.length) return;
  const p=findPath(v.x,v.y,tx,ty);
  v._ptx=tx; v._pty=ty;
  if(p&&p.length){ v.path=p; v.pathI=0; }
  else { v.path=null; v.stuckT+=1; }
}
function moveAlongPath(v,dt,speed){
  if(!v.path||v.pathI>=v.path.length){ v.moving=false; if(v.state==='walk') v.state='idle'; return; }
  const wp=v.path[v.pathI];
  const d=dist(v.x,v.y,wp.x,wp.y);
  if(d<4){ v.pathI++; return; }
  const step=Math.min(speed*dt,d);
  const nx=v.x+(wp.x-v.x)/d*step, ny=v.y+(wp.y-v.y)/d*step;
  // NPCs also respect collision (slide)
  const r=8;
  if(!circleHitsSolid(nx,v.y,r)) v.x=nx;
  if(!circleHitsSolid(v.x,ny,r)) v.y=ny;
  v.face = Math.abs(wp.x-v.x)>Math.abs(wp.y-v.y) ? (wp.x>v.x?3:2) : (wp.y>v.y?0:1);
  v.state='walk'; v.moving=true; v.walkPhase+=dt*(speed/28);
  // stuck detection: if barely moved over time, abandon path
  v.stuckT+=dt;
  if(v.stuckT>1.2){
    const moved=dist(v.x,v.y,v.lastX,v.lastY);
    if(moved<6){ v.path=null; v.pathI=0; v.moving=false; v.state='idle'; }
    v.lastX=v.x; v.lastY=v.y; v.stuckT=0;
  }
}
function circleHitsSolid(x,y,r){
  const x0=Math.floor((x-r)/TILE),x1=Math.floor((x+r)/TILE);
  const y0=Math.floor((y-r)/TILE),y1=Math.floor((y+r)/TILE);
  for(let ty=y0;ty<=y1;ty++)for(let tx=x0;tx<=x1;tx++){
    if(tx<0||ty<0||tx>=MW||ty>=MH) return true;
    if(solid[ty*MW+tx]){
      const cx=clamp(x,tx*TILE,tx*TILE+TILE), cy=clamp(y,ty*TILE,ty*TILE+TILE);
      if((x-cx)*(x-cx)+(y-cy)*(y-cy)<r*r) return true;
    }
  }
  return false;
}
function updateNPC(v,dt){
  if(!v.isNPC) return;
  v.aiT-=dt;
  if(v.aiT<=0){ npcThink(v); v.aiT=0.4+Math.random()*0.4; }
  if(v.talking>0){ v.talking-=dt; if(v.talking<=0&&v.state==='talk') v.state='idle'; }
  // friendly chat: nearby idle NPCs sometimes stop for a word
  if(v.state==='idle'&&Math.random()<0.015){
    for(const u of G.villagers){
      if(u===v||!u.isNPC||u.state!=='idle') continue;
      if(dist(v.x,v.y,u.x,u.y)<30&&dist(v.x,v.y,u.x,u.y)>4){
        v.face=u.x>v.x?3:2; u.face=v.x>u.x?3:2;
        v.state='talk'; v.talking=2.5; u.state='talk'; u.talking=2.5;
        break;
      }
    }
  }
  if(v.state!=='talk'&&v.state!=='sit'&&v.state!=='sleep') moveAlongPath(v,dt,NPC_SPEED);
  else v.moving=false;
  // gentle separation so villagers don't stack
  for(const u of G.villagers){
    if(u===v||!u.isNPC) continue;
    const d=dist(v.x,v.y,u.x,u.y);
    if(d<14&&d>0.01){
      const push=(14-d)*0.5;
      const nx=v.x+(v.x-u.x)/d*push, ny=v.y+(v.y-u.y)/d*push;
      if(!circleHitsSolid(nx,v.y,8)) v.x=nx;
      if(!circleHitsSolid(v.x,ny,8)) v.y=ny;
    }
  }
}
/* =====================================================================
   INPUT + CAMERA + CHARACTER SWITCHING
   ===================================================================== */
const canvas=document.getElementById('game');
const ctx=canvas.getContext('2d');
let CW=800, CH=600, DPR=1;
function resize(){
  DPR=Math.min(2,window.devicePixelRatio||1);
  CW=canvas.clientWidth; CH=canvas.clientHeight;
  canvas.width=Math.round(CW*DPR); canvas.height=Math.round(CH*DPR);
}
window.addEventListener('resize',resize);

function screenToWorld(sx,sy){
  const r=canvas.getBoundingClientRect();
  return { x: G.cam.x + (sx-r.left-CW/2), y: G.cam.y + (sy-r.top-CH/2) };
}
function worldToScreen(wx,wy){
  const r=canvas.getBoundingClientRect();
  return { x: r.left + (wx-G.cam.x) + CW/2, y: r.top + (wy-G.cam.y) + CH/2 };
}

function selectVillager(i,quiet){
  i=((i%G.villagers.length)+G.villagers.length)%G.villagers.length;
  const prev=controlledVillager();
  if(prev){
    prev.isNPC=true; prev.aiT=0.1;
    if(prev.state==='talk'||prev.state==='sit'){ prev.state='idle'; prev.sitAt=null; }
    prev.talking=0;
  }
  G.controlled=i;
  const v=controlledVillager();
  v.isNPC=false; v.path=null; v.moving=false; v.talking=0;
  if(v.state==='sleep'||v.state==='work') v.state='idle';
  v.sitAt=null;
  G.moveTarget=null; G.pendingInter=null; closeDialogue();
  // camera hop: jump partway for a smooth-but-quick transition
  G.cam.x=lerp(G.cam.x,v.x,0.55); G.cam.y=lerp(G.cam.y,v.y,0.55);
  updateCharChip();
  if(!quiet) floater(v.x,v.y-52,'✦ '+v.name);
  sfx('select');
}

function updatePlayer(dt){
  const v=controlledVillager();
  if(!v) return;
  let dx=0,dy=0;
  const k=G.keys;
  if(k['KeyW']||k['ArrowUp'])dy-=1;
  if(k['KeyS']||k['ArrowDown'])dy+=1;
  if(k['KeyA']||k['ArrowLeft'])dx-=1;
  if(k['KeyD']||k['ArrowRight'])dx+=1;
  if(dx||dy){
    G.moveTarget=null; G.pendingInter=null;
    if(v.state==='sit'){ v.state='idle'; v.sitAt=null; }
    const len=Math.hypot(dx,dy); dx/=len; dy/=len;
    const sp=PLAYER_SPEED*(k['ShiftLeft']||k['ShiftRight']?1.45:1);
    const nx=v.x+dx*sp*dt, ny=v.y+dy*sp*dt, r=9;
    if(!circleHitsSolid(nx,v.y,r)) v.x=nx;
    if(!circleHitsSolid(v.x,ny,r)) v.y=ny;
    v.x=clamp(v.x,TILE,WORLD_W-TILE); v.y=clamp(v.y,TILE,WORLD_H-TILE);
    v.face=Math.abs(dx)>Math.abs(dy)?(dx>0?3:2):(dy>0?0:1);
    v.state='walk'; v.moving=true; v.walkPhase+=dt*3.4;
    v.stepT=(v.stepT||0)+dt;
    if(v.stepT>0.32){ v.stepT=0; sfx('step'); }
  } else if(G.moveTarget){
    const t=G.moveTarget, d=dist(v.x,v.y,t.x,t.y);
    if(d<8){
      G.moveTarget=null;
      if(G.pendingInter){ const pi=G.pendingInter; G.pendingInter=null; tryActivate(pi); }
    } else {
      if(!v.path||v.pathI>=v.path.length){
        const p=findPath(v.x,v.y,t.x,t.y);
        if(p){ v.path=p; v.pathI=0; } else G.moveTarget=null;
      }
      moveAlongPath(v,dt,PLAYER_SPEED);
    }
  } else {
    if(v.state==='walk'){ v.state='idle'; }
    v.moving=false;
  }
}
function updateCamera(dt){
  const v=controlledVillager(); if(!v) return;
  const t=1-Math.exp(-5*dt);
  G.cam.x=lerp(G.cam.x,v.x,t); G.cam.y=lerp(G.cam.y,v.y,t);
  const hw=CW/2, hh=CH/2;
  G.cam.x = CW>=WORLD_W ? WORLD_W/2 : clamp(G.cam.x,hw,WORLD_W-hw);
  G.cam.y = CH>=WORLD_H ? WORLD_H/2 : clamp(G.cam.y,hh,WORLD_H-hh);
}

/* ------------------------------ dialogue / prompts ------------------ */
const dlgEl=document.getElementById('dialogue');
function say(name,role,text){
  G.dialogue={name,role,lines:Array.isArray(text)?text:[text],idx:0,shop:false};
  showDialogue();
}
function talkTo(v){
  const me=controlledVillager();
  // face each other
  v.face = me.x>v.x?3:2; me.face = v.x>me.x?2:3;
  if(Math.abs(me.y-v.y)>Math.abs(me.x-v.x)) { v.face=me.y>v.y?0:1; me.face=v.y>me.y?0:1; }
  v.state='talk'; v.talking=6; v.moving=false; v.path=null;
  me.state='talk'; me.talking=6;
  G.dialogue={name:v.name,role:v.role,lines:shuffle(v.lines.slice()),idx:0,shop:false,with:v};
  showDialogue(); sfx('talk');
}
function showDialogue(){
  const d=G.dialogue; if(!d) return;
  document.getElementById('dlg-name').textContent=d.name;
  document.getElementById('dlg-role').textContent=d.role||'';
  document.getElementById('dlg-line').textContent=d.lines[d.idx];
  dlgEl.style.display='block';
}
function advanceDialogue(){
  const d=G.dialogue; if(!d) return;
  d.idx++;
  if(d.idx>=d.lines.length) closeDialogue();
  else showDialogue();
}
function closeDialogue(){
  G.dialogue=null; dlgEl.style.display='none';
  const me=controlledVillager();
  if(me&&me.state==='talk'){ me.state='idle'; me.talking=0; }
  for(const v of G.villagers){ if(v.state==='talk'){ v.state='idle'; v.talking=0; } }
}
function openShop(){
  G.dialogue={name:"Marlow's General Store",role:'Sella — Shopkeeper',
    lines:['Welcome! Bread is 5 gold. I buy crops for 3, fish & herbs for 4.'],
    idx:0,shop:true};
  showDialogue(); sfx('talk');
  document.querySelector('#dialogue .hint').textContent='E: buy bread (5🪙) · Q: sell crops · F: sell fish/herbs · Esc: leave';
}
function shopKey(code){
  const v=controlledVillager();
  const say2=t=>{ G.dialogue.lines=[''+t]; G.dialogue.idx=0; showDialogue(); };
  if(code==='KeyE'){
    if(G.gold>=5){ G.gold-=5; G.inv.bread++; say2('One warm loaf! Come again. (−5 🪙)'); sfx('buy'); }
    else { say2('Not enough gold, dear. Bread is 5 gold.'); sfx('no'); }
  } else if(code==='KeyQ'){
    if(G.inv.crop>0){ const g=G.inv.crop*3; G.gold+=g; say2('Sold '+G.inv.crop+' crops for '+g+' gold!'); G.inv.crop=0; sfx('sell'); }
    else { say2('No crops to sell. Harvest them on Marta’s farm!'); sfx('no'); }
  } else if(code==='KeyF'){
    const n=G.inv.fish+G.inv.herb;
    if(n>0){ const g=G.inv.fish*4+G.inv.herb*4; G.gold+=g; say2('Sold '+n+' goods for '+g+' gold!'); G.inv.fish=0; G.inv.herb=0; sfx('sell'); }
    else { say2('Nothing to sell. Try fishing at the dock!'); sfx('no'); }
  }
  updateTop();
}

/* ------------------------------ interactions ------------------------ */
function floater(wx,wy,text){
  const p=worldToScreen(wx,wy);
  const layer=document.getElementById('floater-layer');
  const el=document.createElement('div');
  el.className='floater'; el.textContent=text;
  el.style.left=(p.x-10)+'px'; el.style.top=(p.y-10)+'px';
  layer.appendChild(el);
  setTimeout(()=>el.remove(),1900);
}
function spawnParticles(x,y,n,color){
  for(let i=0;i<n;i++) G.particles.push({x,y,vx:rand(-40,40),vy:rand(-70,-10),life:rand(.5,1),color});
  if(G.particles.length>300) G.particles.splice(0,G.particles.length-300);
}
function nearestInteractable(v){
  let best=null,bd=1e9;
  for(const it of interactables){
    if(it.cond&&!it.cond()) continue;
    const d=dist(v.x,v.y,it.x,it.y);
    if(d<it.r&&d<bd){ bd=d; best=it; }
  }
  return best;
}
function tryActivate(it){
  if(it.cond&&!it.cond()) return;
  try{ it.action(); }catch(e){ reportError(e); }
}
function harvestCrop(o){
  const v=controlledVillager();
  if(o.growth>0.85){
    if(o.cropKind==='herb'){ G.inv.herb++; floater(v.x,v.y-40,'+1 🌿 herb'); }
    else { G.inv.crop++; floater(v.x,v.y-40,'+1 🌾 crop'); }
    o.growth=0.08; spawnParticles(o.x,o.y-10,10,'#7fae5a'); sfx('pop');
  } else {
    const stage=o.growth<0.25?'just sprouted':o.growth<0.6?'still growing':'almost ripe';
    say(o.cropKind==='herb'?'Herbs':'Crops','', 'These are '+stage+'. Check back later.');
  }
  updateTop();
}
function startFishing(){
  const v=controlledVillager();
  if(v._fishing) return;
  v._fishing=true; v.state='work'; v.workT=0;
  floater(v.x,v.y-46,'🎣 …');
  sfx('splash');
  setTimeout(()=>{
    v._fishing=false;
    if(v.state==='work') v.state='idle';
    if(Math.random()<0.65){ G.inv.fish++; floater(v.x,v.y-46,'+1 🐟 fish!'); spawnParticles(v.x,v.y-20,12,'#7fc4e8'); sfx('catch'); }
    else { floater(v.x,v.y-46,'…nibble… got away'); sfx('splash'); }
    updateTop();
  },2600);
}
function doInteractKey(){
  if(G.dialogue){
    if(G.dialogue.shop) return; // shop uses its own keys
    advanceDialogue(); return;
  }
  const v=controlledVillager();
  const it=nearestInteractable(v);
  if(it) tryActivate(it);
}

/* ------------------------------ mouse / keys ------------------------ */
canvas.addEventListener('mousedown',e=>{
  if(!G.started) return;
  const w=screenToWorld(e.clientX,e.clientY);
  // dialogue click = advance
  if(G.dialogue&&!G.dialogue.shop){ advanceDialogue(); return; }
  // villager hit?
  let best=null,bd=26;
  for(let i=0;i<G.villagers.length;i++){
    const v=G.villagers[i];
    const d=dist(w.x,w.y,v.x,v.y-20);
    if(d<bd){ bd=d; best=i; }
  }
  if(best!==null){
    if(best===G.controlled){ floater(G.villagers[best].x,G.villagers[best].y-52,'That’s you!'); }
    else selectVillager(best);
    return;
  }
  // interactable hit?
  let bit=null,bbd=1e9;
  for(const it of interactables){
    if(it.cond&&!it.cond()) continue;
    const d=dist(w.x,w.y,it.x,it.y);
    if(d<it.r&&d<bbd){ bbd=d; bit=it; }
  }
  const me=controlledVillager();
  if(bit){
    const d=dist(me.x,me.y,bit.x,bit.y);
    if(d<bit.r+14) tryActivate(bit);
    else { // walk there, then activate
      G.moveTarget={x:bit.x,y:bit.y-10}; G.pendingInter=bit;
      const p=findPath(me.x,me.y,bit.x,bit.y-10);
      if(p){ me.path=p; me.pathI=0; }
    }
    return;
  }
  // otherwise: click-to-move
  G.moveTarget={x:clamp(w.x,TILE,WORLD_W-TILE),y:clamp(w.y,TILE,WORLD_H-TILE)};
  G.pendingInter=null;
  sfx('tap');
});
canvas.addEventListener('mousemove',e=>{
  const w=screenToWorld(e.clientX,e.clientY);
  G.hoverV=null;
  for(const v of G.villagers){ if(dist(w.x,w.y,v.x,v.y-20)<26){ G.hoverV=v; break; } }
  canvas.style.cursor=G.hoverV?'pointer':'crosshair';
});
window.addEventListener('keydown',e=>{
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space','Tab'].includes(e.code)) e.preventDefault();
  if(e.code==='Tab'&&G.started){ selectVillager(G.controlled+1); return; }
  if(e.code==='Escape'){
    if(document.getElementById('help').style.display!=='none'){ document.getElementById('help').style.display='none'; return; }
    if(G.dialogue){ closeDialogue(); document.querySelector('#dialogue .hint').textContent='E / click — continue · Esc — close'; return; }
    G.moveTarget=null; return;
  }
  if(!G.started) return;
  G.keys[e.code]=true;
  if(e.code==='KeyE'){
    if(G.dialogue&&G.dialogue.shop) return;
    doInteractKey();
  }
  if(G.dialogue&&G.dialogue.shop&&['KeyE','KeyQ','KeyF'].includes(e.code)) shopKey(e.code);
  if(e.code==='KeyM') toggleMute();
});
window.addEventListener('keyup',e=>{ G.keys[e.code]=false; });
/* =====================================================================
   DAY / NIGHT
   ===================================================================== */
function darkness(){
  const h=G.timeMin/60;
  if(h<4.5||h>=21) return 1;
  if(h<7) return 1-(h-4.5)/2.5;
  if(h<18.5) return 0;
  return (h-18.5)/2.5;
}
function duskness(){
  const h=G.timeMin/60;
  return Math.max(0,1-Math.abs(h-6.3)/1.7, 1-Math.abs(h-19.7)/1.7);
}
function phaseName(){
  const h=G.timeMin/60;
  if(h<5||h>=21) return 'Night';
  if(h<11) return 'Morning';
  if(h<14) return 'Midday';
  if(h<18) return 'Afternoon';
  return 'Evening';
}

/* =====================================================================
   RENDER
   ===================================================================== */
let drawables=[];
function buildDrawables(){
  drawables=[];
  for(const b of buildings) drawables.push({y:py(b.ty)+b.th*TILE, b});
  for(const o of objects) drawables.push({y:o.y, o});
  drawables.sort((a,b)=>a.y-b.y);
}
function render(){
  ctx.setTransform(DPR,0,0,DPR,0,0);
  ctx.clearRect(0,0,CW,CH);
  const cx=G.cam.x-CW/2, cy=G.cam.y-CH/2;
  const dark=darkness(), dusk=duskness();
  // ground
  ctx.drawImage(groundCanvas, cx,cy,CW,CH, 0,0,CW,CH);
  // world-space drawing (camera translated)
  ctx.save();
  ctx.translate(-cx,-cy);
  // static drawables (culled)
  G.glows=[];
  const x0=cx-80, x1=cx+CW+80, y0=cy-120, y1=cy+CH+80;
  for(const d of drawables){
    if(d.b){
      const bx=px(d.b.tx), by=py(d.b.ty);
      if(bx+d.b.tw*TILE<x0||bx>x1||by+d.b.th*TILE<y0-140||by>y1) continue;
      drawBuilding(ctx,d.b,dark>0.45);
      if(dark>0.35&&d.b._glowSpots) for(const s of d.b._glowSpots) G.glows.push({x:s.x,y:s.y,r:44*dark+10,c:'255,200,110'});
    } else if(d.o){
      const o=d.o;
      if(o.x<x0||o.x>x1||o.y<y0-80||o.y>y1) continue;
      o._glow=null;
      drawObject(ctx,o);
      if(o._glow) G.glows.push({x:o._glow.x,y:o._glow.y,r:o._glow.r,c:'255,210,130'});
    }
  }
  // villagers sorted by y
  const vs=G.villagers.slice().sort((a,b)=>a.y-b.y);
  for(const v of vs){
    if(v.x<x0||v.x>x1||v.y<y0-80||v.y>y1) continue;
    drawVillager(ctx,v);
  }
  // particles
  for(const p of G.particles){
    ctx.globalAlpha=clamp(p.life,0,1);
    ctx.fillStyle=p.color; ctx.fillRect(p.x-2,p.y-2,4,4);
  }
  ctx.globalAlpha=1;
  // move target marker
  if(G.moveTarget){
    const sx=G.moveTarget.x, sy=G.moveTarget.y;
    const r=8+Math.sin(G.frame*0.2)*2;
    ctx.strokeStyle='#ffd98a'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(sx,sy,r,0,7); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(sx-4,sy); ctx.lineTo(sx+4,sy); ctx.moveTo(sx,sy-4); ctx.lineTo(sx,sy+4); ctx.stroke();
  }
  ctx.restore(); // back to screen space
  // lighting overlays
  if(dusk>0.02){
    ctx.fillStyle='rgba(255,140,60,'+(dusk*0.14).toFixed(3)+')';
    ctx.fillRect(0,0,CW,CH);
  }
  if(dark>0.02){
    ctx.fillStyle='rgba(12,18,44,'+(dark*0.52).toFixed(3)+')';
    ctx.fillRect(0,0,CW,CH);
    // warm glows
    ctx.globalCompositeOperation='lighter';
    for(const gl of G.glows){
      const sx=gl.x-cx, sy=gl.y-cy;
      if(sx<-gl.r||sy<-gl.r||sx>CW+gl.r||sy>CH+gl.r) continue;
      const grd=ctx.createRadialGradient(sx,sy,4,sx,sy,gl.r);
      grd.addColorStop(0,'rgba('+gl.c+','+(0.5*dark+0.15).toFixed(3)+')');
      grd.addColorStop(1,'rgba('+gl.c+',0)');
      ctx.fillStyle=grd;
      ctx.beginPath(); ctx.arc(sx,sy,gl.r,0,7); ctx.fill();
    }
    ctx.globalCompositeOperation='source-over';
  }
  // name tags
  ctx.textAlign='center';
  for(const v of vs){
    if(v.x<x0||v.x>x1||v.y<y0-80||v.y>y1) continue;
    if(v===controlledVillager()||v===G.hoverV){
      const sx=v.x-cx, sy=v.y-cy;
      ctx.font='bold 12px "Trebuchet MS",sans-serif';
      const w=ctx.measureText(v.name).width+14;
      ctx.fillStyle='rgba(10,14,24,0.75)';
      roundRect(ctx,sx-w/2,sy-72,w,20,8); ctx.fill();
      ctx.fillStyle=v===controlledVillager()?'#ffd98a':'#fff';
      ctx.fillText(v.name,sx,sy-58);
    }
  }
  renderMinimap();
}
const mmCanvas=document.getElementById('minimap');
const mm=mmCanvas.getContext('2d');
function renderMinimap(){
  mm.clearRect(0,0,172,129);
  mm.drawImage(miniGround,0,0,172,129);
  const s=172/MW;
  // viewport
  mm.strokeStyle='rgba(255,255,255,0.7)'; mm.lineWidth=1;
  mm.strokeRect((G.cam.x-CW/2)*s,(G.cam.y-CH/2)*s,CW*s,CH*s);
  for(const v of G.villagers){
    mm.fillStyle=v===controlledVillager()?'#fff':'#ffd98a';
    mm.beginPath(); mm.arc(v.x*s,v.y*s, v===controlledVillager()?3:2.2,0,7); mm.fill();
    mm.strokeStyle='rgba(0,0,0,0.6)'; mm.stroke();
  }
}

/* =====================================================================
   AUDIO (all synthesized, optional)
   ===================================================================== */
let AC=null, masterGain=null;
function initAudio(){
  if(AC) return;
  try{
    AC=new (window.AudioContext||window.webkitAudioContext)();
    masterGain=AC.createGain();
    masterGain.gain.value=G.muted?0:0.45;
    masterGain.connect(AC.destination);
    // wind: looped filtered noise
    const len=AC.sampleRate*2, buf=AC.createBuffer(1,len,AC.sampleRate);
    const d=buf.getChannelData(0);
    for(let i=0;i<len;i++) d[i]=Math.random()*2-1;
    const src=AC.createBufferSource(); src.buffer=buf; src.loop=true;
    const f=AC.createBiquadFilter(); f.type='lowpass'; f.frequency.value=320;
    const g=AC.createGain(); g.gain.value=0.05;
    src.connect(f); f.connect(g); g.connect(masterGain); src.start();
  }catch(e){ /* audio unavailable — game works without it */ }
}
function tone(freq,dur,type,vol,slideTo,delay){
  if(!AC||G.muted) return;
  try{
    const t0=AC.currentTime+(delay||0);
    const o=AC.createOscillator(), g=AC.createGain();
    o.type=type||'sine'; o.frequency.setValueAtTime(freq,t0);
    if(slideTo) o.frequency.exponentialRampToValueAtTime(slideTo,t0+dur);
    g.gain.setValueAtTime(vol||0.15,t0);
    g.gain.exponentialRampToValueAtTime(0.001,t0+dur);
    o.connect(g); g.connect(masterGain);
    o.start(t0); o.stop(t0+dur+0.02);
  }catch(e){}
}
function sfx(name){
  if(!AC||G.muted) return;
  switch(name){
    case 'select': tone(520,0.12,'triangle',0.12,780); break;
    case 'tap': tone(300,0.06,'triangle',0.06); break;
    case 'step': tone(140+Math.random()*30,0.05,'sine',0.035); break;
    case 'talk': tone(440,0.1,'sine',0.1,560); tone(560,0.1,'sine',0.08,660,0.09); break;
    case 'pop': tone(500,0.08,'square',0.07,900); break;
    case 'drink': tone(300,0.15,'sine',0.1,180); tone(220,0.2,'sine',0.08,140,0.12); break;
    case 'buy': tone(660,0.1,'triangle',0.12); tone(880,0.14,'triangle',0.12,null,0.1); break;
    case 'sell': tone(880,0.1,'triangle',0.12); tone(660,0.14,'triangle',0.12,null,0.1); break;
    case 'no': tone(200,0.18,'sawtooth',0.08,150); break;
    case 'splash': tone(400,0.2,'sine',0.09,120); break;
    case 'catch': tone(520,0.1,'triangle',0.12,780); tone(780,0.12,'triangle',0.1,1040,0.1); break;
  }
}
let birdT=0;
function ambientAudio(dt){
  if(!AC||G.muted) return;
  birdT-=dt;
  if(birdT>0) return;
  const dark=darkness();
  if(dark<0.4&&Math.random()<0.7){
    // bird chirp
    const f=2200+Math.random()*1400;
    tone(f,0.09,'sine',0.035,f*1.3); tone(f*1.1,0.08,'sine',0.03,f*0.9,0.12);
    birdT=rand(2,7);
  } else if(dark>0.7){
    // crickets
    for(let i=0;i<3;i++) tone(4200,0.04,'sine',0.02,null,i*0.07);
    birdT=rand(1.5,4);
  } else birdT=2;
}

/* =====================================================================
   UI
   ===================================================================== */
function updateTop(){
  document.getElementById('ui-gold').textContent=G.gold;
  const parts=[];
  if(G.inv.crop)parts.push('🌾'+G.inv.crop);
  if(G.inv.bread)parts.push('🍞'+G.inv.bread);
  if(G.inv.fish)parts.push('🐟'+G.inv.fish);
  if(G.inv.herb)parts.push('🌿'+G.inv.herb);
  document.getElementById('ui-inv').textContent=parts.join(' ')||'empty';
}
function updateCharChip(){
  const v=controlledVillager(); if(!v) return;
  document.getElementById('ui-name').textContent=v.name;
  document.getElementById('ui-role').textContent=v.role;
  document.getElementById('ui-dot').style.background=v.look.shirt;
}
function updateClock(){
  const h=Math.floor(G.timeMin/60)%24, m=Math.floor(G.timeMin%60);
  document.getElementById('ui-clock').textContent=pad2(h)+':'+pad2(m);
  document.getElementById('ui-phase').textContent=phaseName();
  document.getElementById('ui-day').textContent=G.day;
}
function toggleMute(){
  G.muted=!G.muted;
  if(masterGain) masterGain.gain.value=G.muted?0:0.45;
  document.getElementById('btn-sound').textContent=G.muted?'🔇':'🔊';
}
function updatePrompt(){
  const p=document.getElementById('prompt');
  if(G.dialogue||!G.started){ p.style.display='none'; return; }
  const v=controlledVillager();
  const it=nearestInteractable(v);
  if(it){
    p.innerHTML='<b>E</b> — '+it.label+' <span style="color:var(--muted)">· '+it.hint+'</span>';
    p.style.display='block';
    document.getElementById('hint-context').textContent='near: '+it.label;
    G.promptFor=it;
  } else {
    // nearby villager to talk to?
    let nv=null,nd=46;
    for(const u of G.villagers){ if(u===v)continue; const d=dist(v.x,v.y,u.x,u.y); if(d<nd){nd=d;nv=u;} }
    if(nv){
      p.innerHTML='<b>E</b> — talk to '+nv.name+' <span style="color:var(--muted)">· '+nv.role+'</span>';
      p.style.display='block';
      document.getElementById('hint-context').textContent='near: '+nv.name;
      G.promptFor={villager:nv};
    } else { p.style.display='none'; document.getElementById('hint-context').textContent=''; G.promptFor=null; }
  }
}
// E on a nearby villager talks to them
const _doInteractKey=doInteractKey;
doInteractKey=function(){
  if(G.dialogue){ if(!G.dialogue.shop) advanceDialogue(); return; }
  const v=controlledVillager();
  let nv=null,nd=46;
  for(const u of G.villagers){ if(u===v)continue; const d=dist(v.x,v.y,u.x,u.y); if(d<nd){nd=d;nv=u;} }
  if(nv){ talkTo(nv); return; }
  _doInteractKey();
};

document.getElementById('btn-sound').addEventListener('click',toggleMute);
document.getElementById('btn-speed').addEventListener('click',function(){
  G.speed=G.speed===1?2:1;
  this.textContent=G.speed===1?'▶ 1×':'⏩ 2×';
});
document.getElementById('btn-full').addEventListener('click',()=>{
  const el=document.getElementById('app');
  if(document.fullscreenElement) document.exitFullscreen().catch(()=>{});
  else el.requestFullscreen&&el.requestFullscreen().catch(()=>{});
});
document.getElementById('btn-help').addEventListener('click',()=>{
  document.getElementById('help').style.display='flex';
});
document.getElementById('btn-help-close').addEventListener('click',()=>{
  document.getElementById('help').style.display='none';
});
document.getElementById('btn-play').addEventListener('click',()=>{
  document.getElementById('start').style.display='none';
  G.started=true;
  initAudio();
  if(AC&&AC.resume) AC.resume();
  floater(controlledVillager().x,controlledVillager().y-52,'✦ Marta');
});

/* =====================================================================
   MAIN LOOP
   ===================================================================== */
let lastT=0, uiT=0;
function update(dt){
  // clock
  G.timeMin+=dt*G.speed*MIN_PER_SEC;
  if(G.timeMin>=1440){ G.timeMin-=1440; G.day++; }
  // crops grow
  for(const o of objects){
    if(o.kind==='crop'&&o.growth<1) o.growth=Math.min(1,o.growth+dt*G.speed*0.004);
  }
  // villagers
  for(const v of G.villagers){
    if(v.isNPC) updateNPC(v,dt*G.speed);
  }
  updatePlayer(dt);
  updateCamera(dt);
  // particles
  for(let i=G.particles.length-1;i>=0;i--){
    const p=G.particles[i];
    p.x+=p.vx*dt; p.y+=p.vy*dt; p.vy+=160*dt; p.life-=dt*1.4;
    if(p.life<=0) G.particles.splice(i,1);
  }
  ambientAudio(dt);
  G.frame++;
}
function frame(t){
  requestAnimationFrame(frame);
  try{
    const rawDt=Math.min(0.05,(t-lastT)/1000||0.016);
    lastT=t;
    if(G.started) update(rawDt);
    else { G.frame++; }
    render();
    uiT-=rawDt;
    if(uiT<=0){ uiT=0.25; updateClock(); updatePrompt(); }
  }catch(e){ reportError(e); }
}

/* ------------------------------ errors ------------------------------ */
function reportError(e){
  G.errCount++;
  const msg=(e&&(e.stack||e.message||e))+'';
  console.error('[Willowbrook]',msg);
  if(G.errCount<=3){
    const box=document.getElementById('errbox');
    box.textContent='Something hiccuped (this shouldn’t affect play): '+String(msg).slice(0,160);
    box.style.display='block';
    setTimeout(()=>{box.style.display='none';},6000);
  }
}
window.addEventListener('error',e=>reportError(e.error||e.message));
window.addEventListener('unhandledrejection',e=>reportError(e.reason));

/* ------------------------------ boot -------------------------------- */
function setLoad(t){ document.getElementById('load-msg').textContent=t; }
function boot(){
  try{
    setLoad('Building terrain…');
    buildWorld();
    setLoad('Waking villagers…');
    makeVillagers();
    G.villagers[0].isNPC=false;
    setLoad('Lighting lamps…');
    resize();
    buildDrawables();
    updateTop(); updateCharChip(); updateClock();
    // center camera on Marta
    const m0=G.villagers[0];
    G.cam.x=m0.x; G.cam.y=m0.y;
    requestAnimationFrame(frame);
    setLoad('Ready!');
    document.getElementById('loading').style.display='none';
    const qp=new URLSearchParams(location.search);
    if(qp.has('test')||qp.has('autotest')){
      document.getElementById('start').style.display='none';
      G.started=true;
      runAutoTest();
    } else {
      document.getElementById('start').style.display='flex';
    }
  }catch(e){
    reportError(e);
    setLoad('Failed to start: '+(e.message||e));
  }
}
// debug / test API
window.__village={G,tiles,solid,buildings,objects,interactables,
  selectVillager,findPath,talkTo,doInteractKey,darkness,walkable,
  update,controlledVillager,version:'1.0.0'};
if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot);
else boot();
/* =====================================================================
   AUTOTEST HARNESS (?test=1) — drives real gameplay, reports to DOM
   ===================================================================== */
async function runAutoTest(){
  const el=document.getElementById('autotest');
  el.style.display='block';
  const results=[];
  const log=(ok,name,info)=>{
    results.push({ok,name,info});
    el.textContent+= (ok?'PASS':'FAIL')+' | '+name+(info?' — '+info:'')+'\n';
    console.log('[autotest]',ok?'PASS':'FAIL',name,info||'');
  };
  const sleep=ms=>new Promise(r=>setTimeout(r,ms));
  const frames=(n,dt)=>{ for(let i=0;i<n;i++){ update(dt||0.1); } render(); };
  const near=(a,b,e)=>Math.abs(a-b)<=e;
  try{
    await sleep(400);
    /* ---- boot ---- */
    log(G.villagers.length===8,'boot: 8 villagers', G.villagers.length+' spawned');
    log(buildings.length>=10,'boot: buildings', buildings.length+' placed');
    log(interactables.length>25,'boot: interactables', interactables.length+' registered');
    log(!!(groundCanvas&&groundCanvas.width===WORLD_W),'boot: ground prerendered');
    log(G.errCount===0,'boot: no errors during init','errCount='+G.errCount);
    // canvas non-blank check
    try{
      const d=ctx.getImageData(CW/2|0,CH/2|0,40,40).data;
      let sum=0; for(let i=0;i<d.length;i+=4) sum+=d[i]+d[i+1]+d[i+2];
      log(sum>1000,'render: canvas non-blank','pixelSum='+sum);
    }catch(e){ log(false,'render: canvas non-blank',String(e).slice(0,80)); }

    /* ---- movement ---- */
    const v0=controlledVillager();
    const sx0=v0.x, sy0=v0.y;
    G.keys['KeyD']=true; frames(20,0.1); G.keys['KeyD']=false;
    const moved=dist(v0.x,v0.y,sx0,sy0);
    log(moved>30,'move: WASD moves player', 'moved '+moved.toFixed(1)+'px');
    log(v0.state==='idle'||v0.state==='walk','move: anim state valid', v0.state);
    // collision: push into town hall wall
    const hall=buildings.find(b=>b.id==='townhall');
    v0.x=px(hall.tx)-20; v0.y=py(hall.ty+2)+16; v0.path=null;
    G.keys['KeyD']=true; frames(25,0.1); G.keys['KeyD']=false;
    log(v0.x < px(hall.tx)-4,'collision: building blocks player','x='+v0.x.toFixed(0)+' wall at '+px(hall.tx));
    // water blocks
    v0.x=px(43)+16; v0.y=py(30)+16; v0.path=null;
    G.keys['KeyD']=true; frames(25,0.1); G.keys['KeyD']=false;
    const endTile=tileAt(Math.floor(v0.x/TILE),Math.floor(v0.y/TILE));
    log(endTile!==T_WATER&&v0.x<px(49),'collision: water blocks player',
      'endTile='+endTile+' x='+v0.x.toFixed(0));

    /* ---- selection & switching ---- */
    for(let i=0;i<8;i++){ selectVillager(i,true); frames(3,0.1); }
    const nonNpc=G.villagers.filter(v=>!v.isNPC);
    log(G.controlled===7&&nonNpc.length===1&&nonNpc[0]===G.villagers[7],
      'switch: exactly one controlled after 8 switches');
    log(G.villagers[0].isNPC===true,'switch: previous villager resumes NPC AI');
    // camera follows after switch
    selectVillager(2,true); frames(40,0.05);
    const cv=controlledVillager();
    log(dist(G.cam.x,G.cam.y,cv.x,cv.y)<120,'camera: follows newly selected villager',
      'camDist='+dist(G.cam.x,G.cam.y,cv.x,cv.y).toFixed(0));

    /* ---- NPC AI over simulated time ---- */
    G.timeMin=9*60; // 09:00 work time (stays work-hours through the check)
    // scatter NPCs to their homes so the commute is actually exercised
    for(const v of G.villagers){
      if(!v.isNPC) continue;
      v.x=px(v.homeTx)+TILE/2; v.y=py(v.homeTy)+TILE/2+14;
      v.path=null; v.aiT=Math.random()*0.5;
    }
    const minDist=G.villagers.map(()=>1e9);
    for(let f=0;f<600;f++){
      update(0.1);
      G.villagers.forEach((v,i)=>{
        if(v.isNPC){
          const wx=px(v.workTx)+TILE/2, wy=py(v.workTy)+TILE/2;
          minDist[i]=Math.min(minDist[i],dist(v.x,v.y,wx,wy));
        }
      });
      if(f%3===0) render();
    }
    let atWork=0;
    G.villagers.forEach((v,i)=>{ if(v.isNPC&&minDist[i]<80) atWork++; });
    log(atWork>=5,'ai: NPCs commute to work','reachedWork='+atWork+'/7');
    let workN=0, walkN=0;
    G.villagers.forEach((v)=>{
      if(v.isNPC&&v.state==='work') workN++;
      if(v.isNPC&&v.state==='walk') walkN++;
    });
    log(workN+walkN>=3,'ai: NPCs work/walk','work='+workN+' walk='+walkN);
    // no NaN positions
    log(G.villagers.every(v=>isFinite(v.x)&&isFinite(v.y)),'ai: all positions finite');
    // night: villagers head home
    G.timeMin=23*60;
    frames(400,0.15); // 60 sim-seconds
    let homeN=0,sleepN=0;
    for(const v of G.villagers){
      if(!v.isNPC) continue;
      const hx=px(v.homeTx)+TILE/2, hy=py(v.homeTy)+TILE/2+14;
      if(dist(v.x,v.y,hx,hy)<160) homeN++;
      if(v.state==='sleep') sleepN++;
    }
    log(homeN>=4,'ai: villagers return home at night', homeN+'/7 near home, '+sleepN+' asleep');
    log(darkness()>0.9,'daynight: night is dark','darkness='+darkness().toFixed(2));
    G.timeMin=12*60;
    log(darkness()<0.1,'daynight: midday is bright','darkness='+darkness().toFixed(2));
    render(); // night render path exercised above too
    G.timeMin=0; render();
    log(true,'daynight: renders at all hours without error');

    /* ---- pathfinding ---- */
    const p1=findPath(px(32)+16,py(24)+16,px(48)+16,py(30)+16);
    log(!!(p1&&p1.length>5),'pathfind: plaza→pond path found', p1?p1.length+' waypoints':'null');
    const p2=findPath(px(10)+16,py(30)+16,px(20)+16,py(15)+16);
    log(!!(p2&&p2.length>5),'pathfind: farm→smithy path found');
    // path stays on walkable tiles
    let okPath=true;
    if(p1) for(const wp of p1){ if(!walkable(Math.floor(wp.x/TILE),Math.floor(wp.y/TILE))){ okPath=false; break; } }
    log(okPath,'pathfind: waypoints avoid blocked tiles');

    /* ---- interactions ---- */
    selectVillager(0,true);
    const me=controlledVillager();
    const well=objects.find(o=>o.kind==='well');
    me.x=well.x+30; me.y=well.y+10; me.path=null;
    const g0=G.gold;
    doInteractKey(); // nearest = well (drink)
    log(G.gold===g0,'interact: well drink works without error');
    // harvest
    const crop=objects.find(o=>o.kind==='crop'&&o.cropKind==='crop');
    crop.growth=1; me.x=crop.x+20; me.y=crop.y+10; me.path=null;
    const c0=G.inv.crop;
    harvestCrop(crop);
    log(G.inv.crop===c0+1&&crop.growth<0.2,'interact: harvest crop','inv.crop='+G.inv.crop);
    // shop buy/sell
    G.gold=20; const b0=G.inv.bread;
    openShop(); shopKey('KeyE');
    log(G.inv.bread===b0+1&&G.gold===15,'interact: shop buy bread','gold='+G.gold);
    G.inv.crop=2; shopKey('KeyQ');
    log(G.inv.crop===0&&G.gold===21,'interact: shop sell crops','gold='+G.gold);
    closeDialogue();
    // talk to villager
    const other=G.villagers[1];
    other.x=me.x+30; other.y=me.y; other.isNPC=true; other.path=null; other.state='idle';
    doInteractKey();
    log(!!G.dialogue&&G.dialogue.name===other.name,'interact: talk opens dialogue', G.dialogue?G.dialogue.name:'none');
    const lines=G.dialogue.lines.length;
    for(let i=0;i<lines;i++) advanceDialogue();
    log(!G.dialogue,'interact: dialogue advances & closes');
    // fishing (async)
    me.x=px(46)+16; me.y=py(30)+16; me.path=null;
    startFishing();
    await sleep(3100);
    log(!me._fishing,'interact: fishing resolves','fish='+G.inv.fish);
    // bench sit
    const bench=objects.find(o=>o.kind==='bench');
    me.x=bench.x+20; me.y=bench.y+10; me.path=null;
    const benchIt=interactables.find(i=>i.label==='Bench'&&dist(i.x,i.y,bench.x,bench.y)<4);
    tryActivate(benchIt);
    log(me.state==='sit','interact: bench sit');
    G.keys['KeyW']=true; frames(5,0.1); G.keys['KeyW']=false;
    log(me.state!=='sit','interact: moving stands up from bench');

    /* ---- click-to-move ---- */
    me.x=px(32)+16; me.y=py(26)+16; me.path=null; me.state='idle';
    G.moveTarget={x:px(36)+16,y:py(26)+16};
    frames(60,0.1);
    log(!G.moveTarget&&dist(me.x,me.y,px(36)+16,py(26)+16)<40,'input: click-to-move arrives');

    /* ---- performance ---- */
    const t0=performance.now();
    frames(600,0.016);
    const ms=performance.now()-t0;
    log(ms<15000,'perf: 600 update+render frames','total '+(ms/1000).toFixed(1)+'s, '+(ms/600).toFixed(2)+'ms/frame');

    /* ---- final ---- */
    log(G.errCount===0,'no runtime errors across whole pass','errCount='+G.errCount);
    updateTop(); updateCharChip(); updateClock(); updatePrompt();
    log(true,'ui: HUD updates without error');
  }catch(e){
    log(false,'autotest exception',(e&&e.stack||e+'').slice(0,300));
  }
  const passed=results.filter(r=>r.ok).length;
  const total=results.length;
  el.textContent+='\n==== '+passed+'/'+total+' passed ====\n';
  document.title='AUTOTEST '+passed+'/'+total;
  console.log('[autotest] DONE '+passed+'/'+total);
  window.__autotestDone=true;
  window.__autotestResults=results;
}
</script>
</body>
</html>
