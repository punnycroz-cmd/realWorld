# infra.env.example — canonical secrets/env inventory for launch.
# Copy to infra.env.local (gitignored) and fill at provisioning time.
# NEVER commit real values. NEVER paste real values into tickets/chat.

# ── Deploy (deploy-site.sh) ───────────────────────────────────────────
RW_DEPLOY_HOST=deploy@203.0.113.10        # SSH user@host of the site VPS
RW_DEPLOY_PATH=/srv/www/realworld         # contains releases/ + current symlink
# RW_DEPLOY_SSH=-i ~/.ssh/rw_deploy       # optional key/options

# ── Public (non-secret, but centralized) ──────────────────────────────
RW_DOMAIN=realworld-game.example          # PLACEHOLDER — real domain at launch
RW_PLAY_ORIGIN=https://play.realworld-game.example   # spectator embed origin
RW_ANALYTICS_ENDPOINT=https://stats.realworld-game.example/e   # -> site data-endpoint

# ── Stripe (GAME-SIDE only — the static site never sees these) ────────
# Created at Stripe provisioning (INFRASTRUCTURE.md §5 step 6).
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...             # game backend only
STRIPE_WEBHOOK_SECRET=whsec_...           # game backend webhook verification
# Use pk_test_/sk_test_ on staging until the launch flip.

# ── Analytics backend (Umami/Plausible/self-host on stats.<domain>) ────
# RW_ANALYTICS_DB_URL=postgres://...      # backend-side only, if self-hosted

# ── Ops ───────────────────────────────────────────────────────────────
# RW_UPTIME_ALERT_EMAIL=owner@...
# RW_STATUSPAGE_TOKEN=...                  # if a status page is adopted later
